{
	Tools = ordered() {
		LDF_ZoomColpo = MacroOperator {
			Inputs = ordered() {
				MainInput1 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Input",
					Name = "Input",
				},
				Input1 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Pivot",
					Name = "Punto di zoom (trascinalo sul soggetto)",
				},
				Input2 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Center",
					Name = "Sposta inquadratura",
				},
				Input3 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Mode",
				},
				Input4 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "From",
				},
				Input5 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "To",
				},
				Input6 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Start",
				},
				Input7 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Dur",
				},
				Input8 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Curve",
				},
				Input9 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Bounce",
				},
				Input10 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Hold",
				},
				Input11 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Back",
				},
				Input12 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Steps",
				},
				Input13 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Every",
				},
				Input14 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Tilt",
				},
				Input15 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Shake",
				},
				Input16 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "ZBlur",
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Mosso",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Ctrl = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Size = Input {
							Expression = ":local function cv(x)\n  x=min(max(x,0),1)\n  local m=Curve\n  if m<0.5 then return 1-(1-x)^4 end\n  if m<1.5 then if x<0.5 then return 4*x^3 end return 1-((-2*x+2)^3)/2 end\n  if m<2.5 then return x^3 end\n  if m<3.5 then return x end\n  local k=Bounce\n  return 1+(k+1)*(x-1)^3+k*(x-1)^2\nend\nlocal function st(f,a,d)\n  if d<1 then if f>=a then return 1 end return 0 end\n  return min(max((f-a)/d,0),1)\nend\nlocal function val(f)\n  local M=Mode\n  local a=Start\n  local d=Dur\n  if M<0.5 then return cv(st(f,a,d)) end\n  if M<1.5 then return min(cv(st(f,a,d)),cv(st(comp.RenderEnd-comp.RenderStart-f,0,Back))) end\n  if M<2.5 then return max(cv(st(f,a,d))-cv(st(f,a+d+Hold,Back)),0) end\n  if M<3.5 then return 1-cv(st(f,a,d)) end\n  if M<4.5 then\n    local n=max(floor(Steps+0.5),1)\n    local s=0\n    for i=0,n-1 do s=s+cv(st(f,a+i*Every,d)) end\n    return s/n\n  end\n  if f<a then return 0 end\n  local ph=(f-a)%max(Every,1)\n  return max(cv(st(ph,0,d))-cv(st(ph,d+Hold,Back)),0)\nend\nlocal function zoom(f) return max((From+(To-From)*val(f))/100,0.01) end\nlocal function arrivo(f)\n  local M=Mode\n  local a=Start\n  local d=Dur\n  local e=max(Every,1)\n  if M>3.5 and M<4.5 then\n    local k=min(floor((f-a-d)/e),max(floor(Steps+0.5),1)-1)\n    return a+max(k,0)*e+d\n  end\n  if M>4.5 then return a+max(floor((f-a)/e),0)*e+d end\n  return a+d\nend\nreturn zoom((time-comp.RenderStart))",
						},
						Angle = Input {
							Expression = ":local function cv(x)\n  x=min(max(x,0),1)\n  local m=Curve\n  if m<0.5 then return 1-(1-x)^4 end\n  if m<1.5 then if x<0.5 then return 4*x^3 end return 1-((-2*x+2)^3)/2 end\n  if m<2.5 then return x^3 end\n  if m<3.5 then return x end\n  local k=Bounce\n  return 1+(k+1)*(x-1)^3+k*(x-1)^2\nend\nlocal function st(f,a,d)\n  if d<1 then if f>=a then return 1 end return 0 end\n  return min(max((f-a)/d,0),1)\nend\nlocal function val(f)\n  local M=Mode\n  local a=Start\n  local d=Dur\n  if M<0.5 then return cv(st(f,a,d)) end\n  if M<1.5 then return min(cv(st(f,a,d)),cv(st(comp.RenderEnd-comp.RenderStart-f,0,Back))) end\n  if M<2.5 then return max(cv(st(f,a,d))-cv(st(f,a+d+Hold,Back)),0) end\n  if M<3.5 then return 1-cv(st(f,a,d)) end\n  if M<4.5 then\n    local n=max(floor(Steps+0.5),1)\n    local s=0\n    for i=0,n-1 do s=s+cv(st(f,a+i*Every,d)) end\n    return s/n\n  end\n  if f<a then return 0 end\n  local ph=(f-a)%max(Every,1)\n  return max(cv(st(ph,0,d))-cv(st(ph,d+Hold,Back)),0)\nend\nlocal function zoom(f) return max((From+(To-From)*val(f))/100,0.01) end\nlocal function arrivo(f)\n  local M=Mode\n  local a=Start\n  local d=Dur\n  local e=max(Every,1)\n  if M>3.5 and M<4.5 then\n    local k=min(floor((f-a-d)/e),max(floor(Steps+0.5),1)-1)\n    return a+max(k,0)*e+d\n  end\n  if M>4.5 then return a+max(floor((f-a)/e),0)*e+d end\n  return a+d\nend\nreturn Tilt*val((time-comp.RenderStart))",
						},
						Edges = Input { Value = 3, },
						Mode = Input { Value = 2, },
						From = Input { Value = 100, },
						To = Input { Value = 140, },
						Start = Input { Value = 0, },
						Dur = Input { Value = 5, },
						Curve = Input { Value = 4, },
						Bounce = Input { Value = 1.2, },
						Hold = Input { Value = 12, },
						Back = Input { Value = 8, },
						Steps = Input { Value = 3, },
						Every = Input { Value = 15, },
						Tilt = Input { Value = 0, },
						Shake = Input { Value = 0.8, },
						ZBlur = Input { Value = 0.8, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Mode = {
							{ CCS_AddString = "Zoom e resta" },
							{ CCS_AddString = "Zoom e ritorno a fine clip" },
							{ CCS_AddString = "Colpo: entra e torna" },
							{ CCS_AddString = "Parte zoomato e si allarga" },
							{ CCS_AddString = "Zoom a scalini" },
							{ CCS_AddString = "Battito a ritmo" },
							LINKS_Name = "Andamento",
							LINKID_DataType = "Number",
							INPID_InputControl = "ComboControl",
							INP_Default = 2,
							INP_Integer = true,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 5,
							CC_LabelPosition = "Horizontal",
							ICS_ControlPage = "Controls",
						},
						From = {
							LINKS_Name = "Zoom normale (%)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 100,
							INP_MinScale = 50,
							INP_MaxScale = 200,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 1,
							INP_MaxAllowed = 2000,
						},
						To = {
							LINKS_Name = "Zoom massimo (%)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 140,
							INP_MinScale = 100,
							INP_MaxScale = 300,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 1,
							INP_MaxAllowed = 2000,
						},
						Start = {
							LINKS_Name = "Inizia dopo (frame)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 0,
							INP_MaxAllowed = 100000,
						},
						Dur = {
							LINKS_Name = "Durata zoom (frame, 0 = istantaneo)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 5,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 0,
							INP_MaxAllowed = 10000,
						},
						Curve = {
							{ CCS_AddString = "Scatto (parte veloce)" },
							{ CCS_AddString = "Morbida" },
							{ CCS_AddString = "Accelera (parte lenta)" },
							{ CCS_AddString = "Lineare" },
							{ CCS_AddString = "Con rimbalzo" },
							LINKS_Name = "Curva",
							LINKID_DataType = "Number",
							INPID_InputControl = "ComboControl",
							INP_Default = 4,
							INP_Integer = true,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 4,
							CC_LabelPosition = "Horizontal",
							ICS_ControlPage = "Controls",
						},
						Bounce = {
							LINKS_Name = "Quantità rimbalzo (curva Con rimbalzo)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1.2,
							INP_MinScale = 0,
							INP_MaxScale = 4,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Hold = {
							LINKS_Name = "Tenuta prima del ritorno (frame)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 12,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 0,
							INP_MaxAllowed = 10000,
						},
						Back = {
							LINKS_Name = "Durata ritorno (frame)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 8,
							INP_MinScale = 1,
							INP_MaxScale = 60,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 1,
							INP_MaxAllowed = 10000,
						},
						Steps = {
							LINKS_Name = "Numero di scalini",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 3,
							INP_MinScale = 1,
							INP_MaxScale = 8,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 1,
							INP_MaxAllowed = 50,
						},
						Every = {
							LINKS_Name = "Frame tra scalini / battiti",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 15,
							INP_MinScale = 2,
							INP_MaxScale = 60,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 1,
							INP_MaxAllowed = 10000,
						},
						Tilt = {
							LINKS_Name = "Inclinazione durante lo zoom (gradi)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = -10,
							INP_MaxScale = 10,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Shake = {
							LINKS_Name = "Scossa all'arrivo",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.8,
							INP_MinScale = 0,
							INP_MaxScale = 2,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						ZBlur = {
							LINKS_Name = "Sfocatura di movimento",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.8,
							INP_MinScale = 0,
							INP_MaxScale = 2,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Scossa = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input {
							SourceOp = "Ctrl",
							Source = "Output",
						},
						Edges = Input { Value = 3, },
						Center = Input {
							Expression = ":local function cv(x)\n  x=min(max(x,0),1)\n  local m=Ctrl.Curve\n  if m<0.5 then return 1-(1-x)^4 end\n  if m<1.5 then if x<0.5 then return 4*x^3 end return 1-((-2*x+2)^3)/2 end\n  if m<2.5 then return x^3 end\n  if m<3.5 then return x end\n  local k=Ctrl.Bounce\n  return 1+(k+1)*(x-1)^3+k*(x-1)^2\nend\nlocal function st(f,a,d)\n  if d<1 then if f>=a then return 1 end return 0 end\n  return min(max((f-a)/d,0),1)\nend\nlocal function val(f)\n  local M=Ctrl.Mode\n  local a=Ctrl.Start\n  local d=Ctrl.Dur\n  if M<0.5 then return cv(st(f,a,d)) end\n  if M<1.5 then return min(cv(st(f,a,d)),cv(st(comp.RenderEnd-comp.RenderStart-f,0,Ctrl.Back))) end\n  if M<2.5 then return max(cv(st(f,a,d))-cv(st(f,a+d+Ctrl.Hold,Ctrl.Back)),0) end\n  if M<3.5 then return 1-cv(st(f,a,d)) end\n  if M<4.5 then\n    local n=max(floor(Ctrl.Steps+0.5),1)\n    local s=0\n    for i=0,n-1 do s=s+cv(st(f,a+i*Ctrl.Every,d)) end\n    return s/n\n  end\n  if f<a then return 0 end\n  local ph=(f-a)%max(Ctrl.Every,1)\n  return max(cv(st(ph,0,d))-cv(st(ph,d+Ctrl.Hold,Ctrl.Back)),0)\nend\nlocal function zoom(f) return max((Ctrl.From+(Ctrl.To-Ctrl.From)*val(f))/100,0.01) end\nlocal function arrivo(f)\n  local M=Ctrl.Mode\n  local a=Ctrl.Start\n  local d=Ctrl.Dur\n  local e=max(Ctrl.Every,1)\n  if M>3.5 and M<4.5 then\n    local k=min(floor((f-a-d)/e),max(floor(Ctrl.Steps+0.5),1)-1)\n    return a+max(k,0)*e+d\n  end\n  if M>4.5 then return a+max(floor((f-a)/e),0)*e+d end\n  return a+d\nend\nlocal e=((time-comp.RenderStart)-arrivo((time-comp.RenderStart)))/1\nif e<0 or Ctrl.Shake<=0 then return Point(0.5,0.5) end\nlocal a=Ctrl.Shake*0.01*exp(-e/4)\nreturn Point(0.5+a*sin(e*2.9+1), 0.5+a*cos(e*3.7))",
						},
						Angle = Input {
							Expression = ":local function cv(x)\n  x=min(max(x,0),1)\n  local m=Ctrl.Curve\n  if m<0.5 then return 1-(1-x)^4 end\n  if m<1.5 then if x<0.5 then return 4*x^3 end return 1-((-2*x+2)^3)/2 end\n  if m<2.5 then return x^3 end\n  if m<3.5 then return x end\n  local k=Ctrl.Bounce\n  return 1+(k+1)*(x-1)^3+k*(x-1)^2\nend\nlocal function st(f,a,d)\n  if d<1 then if f>=a then return 1 end return 0 end\n  return min(max((f-a)/d,0),1)\nend\nlocal function val(f)\n  local M=Ctrl.Mode\n  local a=Ctrl.Start\n  local d=Ctrl.Dur\n  if M<0.5 then return cv(st(f,a,d)) end\n  if M<1.5 then return min(cv(st(f,a,d)),cv(st(comp.RenderEnd-comp.RenderStart-f,0,Ctrl.Back))) end\n  if M<2.5 then return max(cv(st(f,a,d))-cv(st(f,a+d+Ctrl.Hold,Ctrl.Back)),0) end\n  if M<3.5 then return 1-cv(st(f,a,d)) end\n  if M<4.5 then\n    local n=max(floor(Ctrl.Steps+0.5),1)\n    local s=0\n    for i=0,n-1 do s=s+cv(st(f,a+i*Ctrl.Every,d)) end\n    return s/n\n  end\n  if f<a then return 0 end\n  local ph=(f-a)%max(Ctrl.Every,1)\n  return max(cv(st(ph,0,d))-cv(st(ph,d+Ctrl.Hold,Ctrl.Back)),0)\nend\nlocal function zoom(f) return max((Ctrl.From+(Ctrl.To-Ctrl.From)*val(f))/100,0.01) end\nlocal function arrivo(f)\n  local M=Ctrl.Mode\n  local a=Ctrl.Start\n  local d=Ctrl.Dur\n  local e=max(Ctrl.Every,1)\n  if M>3.5 and M<4.5 then\n    local k=min(floor((f-a-d)/e),max(floor(Ctrl.Steps+0.5),1)-1)\n    return a+max(k,0)*e+d\n  end\n  if M>4.5 then return a+max(floor((f-a)/e),0)*e+d end\n  return a+d\nend\nlocal e=((time-comp.RenderStart)-arrivo((time-comp.RenderStart)))/1\nif e<0 or Ctrl.Shake<=0 then return 0 end\nlocal a=Ctrl.Shake*0.01*exp(-e/4)\nreturn a*60*sin(e*2.1)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Mosso = DirectionalBlur {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input {
							SourceOp = "Scossa",
							Source = "Output",
						},
						Type = Input { Value = 3, },
						Center = Input {
							Expression = "Point(Ctrl.Pivot.X+Ctrl.Center.X-0.5, Ctrl.Pivot.Y+Ctrl.Center.Y-0.5)",
						},
						Length = Input {
							Expression = ":local function cv(x)\n  x=min(max(x,0),1)\n  local m=Ctrl.Curve\n  if m<0.5 then return 1-(1-x)^4 end\n  if m<1.5 then if x<0.5 then return 4*x^3 end return 1-((-2*x+2)^3)/2 end\n  if m<2.5 then return x^3 end\n  if m<3.5 then return x end\n  local k=Ctrl.Bounce\n  return 1+(k+1)*(x-1)^3+k*(x-1)^2\nend\nlocal function st(f,a,d)\n  if d<1 then if f>=a then return 1 end return 0 end\n  return min(max((f-a)/d,0),1)\nend\nlocal function val(f)\n  local M=Ctrl.Mode\n  local a=Ctrl.Start\n  local d=Ctrl.Dur\n  if M<0.5 then return cv(st(f,a,d)) end\n  if M<1.5 then return min(cv(st(f,a,d)),cv(st(comp.RenderEnd-comp.RenderStart-f,0,Ctrl.Back))) end\n  if M<2.5 then return max(cv(st(f,a,d))-cv(st(f,a+d+Ctrl.Hold,Ctrl.Back)),0) end\n  if M<3.5 then return 1-cv(st(f,a,d)) end\n  if M<4.5 then\n    local n=max(floor(Ctrl.Steps+0.5),1)\n    local s=0\n    for i=0,n-1 do s=s+cv(st(f,a+i*Ctrl.Every,d)) end\n    return s/n\n  end\n  if f<a then return 0 end\n  local ph=(f-a)%max(Ctrl.Every,1)\n  return max(cv(st(ph,0,d))-cv(st(ph,d+Ctrl.Hold,Ctrl.Back)),0)\nend\nlocal function zoom(f) return max((Ctrl.From+(Ctrl.To-Ctrl.From)*val(f))/100,0.01) end\nlocal function arrivo(f)\n  local M=Ctrl.Mode\n  local a=Ctrl.Start\n  local d=Ctrl.Dur\n  local e=max(Ctrl.Every,1)\n  if M>3.5 and M<4.5 then\n    local k=min(floor((f-a-d)/e),max(floor(Ctrl.Steps+0.5),1)-1)\n    return a+max(k,0)*e+d\n  end\n  if M>4.5 then return a+max(floor((f-a)/e),0)*e+d end\n  return a+d\nend\nreturn min(Ctrl.ZBlur*abs(zoom((time-comp.RenderStart))-zoom((time-comp.RenderStart)-1))/zoom((time-comp.RenderStart))*1.5*1,0.25)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
			},
		},
	},
	ActiveTool = "LDF_ZoomColpo"
}
