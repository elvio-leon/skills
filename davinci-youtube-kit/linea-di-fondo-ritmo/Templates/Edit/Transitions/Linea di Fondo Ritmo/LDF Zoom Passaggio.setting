{
	Tools = ordered() {
		LDF_ZoomPassaggio = MacroOperator {
			Inputs = ordered() {
				MainInput1 = InstanceInput {
					SourceOp = "ClipA",
					Source = "Input",
					Name = "Clip in uscita",
				},
				MainInput2 = InstanceInput {
					SourceOp = "ClipB",
					Source = "Input",
					Name = "Clip in entrata",
				},
				Input1 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Dir",
				},
				Input2 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Zoom",
				},
				Input3 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Blur",
				},
				Input4 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Spin",
				},
				Input5 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Flash",
				},
				Input6 = InstanceInput {
					SourceOp = "ClipA",
					Source = "Pivot",
					Name = "Punto di zoom",
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Lampo",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				ClipA = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Edges = Input { Value = 3, },
						Angle = Input {
							Expression = "Ctrl.Spin*((min(max(Ctrl.Mix*2,0),1))^3)",
						},
						Size = Input {
							Expression = "iif(Ctrl.Dir<0.5, 1+Ctrl.Zoom*((min(max(Ctrl.Mix*2,0),1))^3), 1/(1+Ctrl.Zoom*((min(max(Ctrl.Mix*2,0),1))^3)))",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				ClipB = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Edges = Input { Value = 3, },
						Angle = Input {
							Expression = "-Ctrl.Spin*(1-(1-(1-min(max(Ctrl.Mix*2-1,0),1))^3))",
						},
						Pivot = Input {
							Expression = "ClipA.Pivot",
						},
						Size = Input {
							Expression = "iif(Ctrl.Dir<0.5, 1/(1+Ctrl.Zoom*(1-(1-(1-min(max(Ctrl.Mix*2-1,0),1))^3))), 1+Ctrl.Zoom*(1-(1-(1-min(max(Ctrl.Mix*2-1,0),1))^3)))",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Taglio = Dissolve {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "ClipA",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "ClipB",
							Source = "Output",
						},
						Mix = Input {
							Expression = "min(max((Ctrl.Mix-0.5+0.03)/0.06,0),1)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				ZoomBlur = DirectionalBlur {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input {
							SourceOp = "Taglio",
							Source = "Output",
						},
						Type = Input { Value = 3, },
						Center = Input {
							Expression = "ClipA.Pivot",
						},
						Length = Input {
							Expression = "Ctrl.Blur*0.3*sin(pi*Ctrl.Mix)^2",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
				},
				Luce = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.961, },
						TopLeftGreen = Input { Value = 0.937, },
						TopLeftBlue = Input { Value = 0.902, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
				},
				Lampo = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "ZoomBlur",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Luce",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Expression = "Ctrl.Flash*(1-abs(2*Ctrl.Mix-1))^4",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 550, 0 } },
				},
				Ctrl = Dissolve {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Mix = Input {
							SourceOp = "CtrlCurve",
							Source = "Value",
						},
						Dir = Input { Value = 0, },
						Zoom = Input { Value = 1.2, },
						Blur = Input { Value = 0.6, },
						Spin = Input { Value = 0, },
						Flash = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 660, 0 } },
					UserControls = ordered() {
						Dir = {
							{ CCS_AddString = "Zoom in avanti" },
							{ CCS_AddString = "Zoom all'indietro" },
							LINKS_Name = "Direzione",
							LINKID_DataType = "Number",
							INPID_InputControl = "ComboControl",
							INP_Default = 0,
							INP_Integer = true,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							CC_LabelPosition = "Horizontal",
							ICS_ControlPage = "Controls",
						},
						Zoom = {
							LINKS_Name = "Intensità zoom",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1.2,
							INP_MinScale = 0.2,
							INP_MaxScale = 4,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Blur = {
							LINKS_Name = "Sfocatura",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.6,
							INP_MinScale = 0,
							INP_MaxScale = 1.5,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Spin = {
							LINKS_Name = "Rotazione (gradi)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = -90,
							INP_MaxScale = 90,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Flash = {
							LINKS_Name = "Lampo avorio sul taglio",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				CtrlCurve = LUTLookup {
					Inputs = {
						Source = Input { Value = FuID { "Duration" }, },
						Lookup = Input {
							SourceOp = "CtrlCurveLookup",
							Source = "Value",
						},
					},
				},
				CtrlCurveLookup = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							[1] = { 1, LH = { 0.666666666666667, 0.666666666666667 }, Flags = { Linear = true } }
						}
					},
					SplineColor = { Red = 255, Green = 255, Blue = 255 },
				},
			},
		},
	},
	ActiveTool = "LDF_ZoomPassaggio"
}
