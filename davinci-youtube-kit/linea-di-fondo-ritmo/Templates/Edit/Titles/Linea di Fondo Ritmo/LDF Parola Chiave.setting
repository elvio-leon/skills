							INPID_InputControl = "SliderControl",
							INP_Default = 140,
							INP_MinScale = 100,
							INP_MaxScale = 300,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 1,
							INP_MaxAllowed = 1000,
