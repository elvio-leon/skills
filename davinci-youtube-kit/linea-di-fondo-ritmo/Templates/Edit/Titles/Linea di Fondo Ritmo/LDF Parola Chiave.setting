							INP_Default = 0.16,
							INP_MinScale = 0.02,
							INP_MaxScale = 0.6,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
	},
	ActiveTool = "LDF_ParolaChiave"
