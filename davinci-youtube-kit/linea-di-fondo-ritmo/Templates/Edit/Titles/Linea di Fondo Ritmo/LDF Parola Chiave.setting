{
	Tools = ordered() {
		LDF_ParolaChiave = MacroOperator {
			Inputs = ordered() {
				Input1 = InstanceInput {
					SourceOp = "Testo",
					Source = "StyledText",
					Name = "Parola",
				},
				Input2 = InstanceInput {
					SourceOp = "Testo",
					Source = "Style",
					Name = "Stile parola",
				},
				Input3 = InstanceInput {
					SourceOp = "Testo",
					Source = "Size",
					Name = "Dimensione parola",
					Default = 0.11,
				},
				Input4 = InstanceInput {
					SourceOp = "Testo",
					Source = "Red1",
					Name = "Colore parola",
					ControlGroup = 1,
				},
				Input5 = InstanceInput {
					SourceOp = "Testo",
					Source = "Green1",
					ControlGroup = 1,
				},
				Input6 = InstanceInput {
					SourceOp = "Testo",
					Source = "Blue1",
					ControlGroup = 1,
				},
				Input7 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Center",
					Name = "Posizione",
				},
				Input8 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Speed",
				},
				Input9 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "OutDur",
				},
				Input10 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Shadow",
				},
				Input11 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Punch",
				},
				Input12 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Line",
				},
				Input13 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "LineLen",
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Ctrl",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				Testo = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "DECISIVO", },
						Font = Input { Value = "Optima", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.11, },
						VerticalJustificationNew = Input { Value = 3, },
						HorizontalJustificationNew = Input { Value = 3, },
						Center = Input { Value = { 0.5, 0.5 }, },
						Red1 = Input { Value = 0.961, },
						Green1 = Input { Value = 0.937, },
						Blue1 = Input { Value = 0.902, },
						ElementShape1 = Input { Value = 0, },
						CharacterSpacing = Input { Value = 1.02, },
						Enabled3 = Input {
							Expression = "Ctrl.Shadow",
						},
						ElementShape3 = Input { Value = 0, },
						Red3 = Input { Value = 0, },
						Green3 = Input { Value = 0, },
						Blue3 = Input { Value = 0, },
						Alpha3 = Input { Value = 0.55, },
						Offset3 = Input { Value = { 0, -0.004 }, },
						Softness3 = Input { Value = 1, },
						SoftnessX3 = Input { Value = 10, },
						SoftnessY3 = Input { Value = 10, },
						PriorityBack3 = Input { Value = 5, },
						PriorityBack1 = Input { Value = 10, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Sfoca = Blur {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input {
							SourceOp = "Testo",
							Source = "Output",
						},
						XBlurSize = Input {
							Expression = "8*(1-(1-(1-min(max(((time-comp.RenderStart)-(0)*Ctrl.Speed)/max((7)*Ctrl.Speed,1),0),1))^4))",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				LineaMask = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input {
							Expression = "Point(0.5, 0.435)",
						},
						Width = Input {
							Expression = "(Ctrl.LineLen)*((1-(1-min(max(((time-comp.RenderStart)-(5)*Ctrl.Speed)/max((8)*Ctrl.Speed,1),0),1))^4))",
						},
						Height = Input {
							Expression = "(5)/Ctrl.Background.OriginalHeight",
						},
						SoftEdge = Input { Value = 0.0003, },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
				},
				Linea = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.71, },
						TopLeftGreen = Input { Value = 0.196, },
						TopLeftBlue = Input { Value = 0.235, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input {
							SourceOp = "LineaMask",
							Source = "Mask",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
				},
				Livello1 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Canvas",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Sfoca",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Expression = "(1-(1-min(max(((time-comp.RenderStart)-(0)*Ctrl.Speed)/max((7)*Ctrl.Speed,1),0),1))^4)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 550, 0 } },
				},
				Livello2 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Livello1",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Linea",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Expression = "Ctrl.Line",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 660, 0 } },
				},
				Ctrl = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Canvas",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Livello2",
							Source = "Output",
						},
						Center = Input { Value = { 0.5, 0.5 }, },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Expression = "min(max((comp.RenderEnd-time)/max(OutDur,1),0),1)",
						},
						Speed = Input { Value = 1, },
						OutDur = Input { Value = 8, },
						Shadow = Input { Value = 1, },
						Punch = Input { Value = 140, },
						Line = Input { Value = 1, },
						LineLen = Input { Value = 0.16, },
						Size = Input {
							Expression = "Punch/100+(1-Punch/100)*(1+1.8*((min(max(((time-comp.RenderStart)-(0)*Speed)/max((7)*Speed,1),0),1))-1)^3+0.8*((min(max(((time-comp.RenderStart)-(0)*Speed)/max((7)*Speed,1),0),1))-1)^2)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 770, 0 } },
					UserControls = ordered() {
						Speed = {
							LINKS_Name = "Durata animazioni (1 = normale, 0.5 = più scattante, 2 = più lenta)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0.3,
							INP_MaxScale = 3,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 0.05,
							INP_MaxAllowed = 20,
						},
						OutDur = {
							LINKS_Name = "Durata uscita (frame)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 8,
							INP_MinScale = 1,
							INP_MaxScale = 60,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 1,
							INP_MaxAllowed = 600,
						},
						Shadow = {
							LINKS_Name = "Ombra per leggibilità su video",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Default = 1,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
						},
						Punch = {
