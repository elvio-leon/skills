{
	Tools = ordered() {
		LDF_Didascalie = MacroOperator {
			Inputs = ordered() {
				Input1 = InstanceInput {
					SourceOp = "Sorgente",
					Source = "StyledText",
					Name = "Frase",
				},
				Input2 = InstanceInput {
					SourceOp = "Testo",
					Source = "Style",
					Name = "Stile",
				},
				Input3 = InstanceInput {
					SourceOp = "Testo",
					Source = "Size",
					Name = "Dimensione testo",
					Default = 0.075,
				},
				Input4 = InstanceInput {
					SourceOp = "Testo",
					Source = "Red1",
					Name = "Colore testo",
					ControlGroup = 1,
				},
				Input5 = InstanceInput {
					SourceOp = "Testo",
					Source = "Green1",
					ControlGroup = 1,
				},
				Input6 = InstanceInput {
					SourceOp = "Testo",
					Source = "Blue1",
					ControlGroup = 1,
				},
				Input7 = InstanceInput {
					SourceOp = "Testo",
					Source = "Red4",
					Name = "Colore riquadro",
					ControlGroup = 4,
				},
				Input8 = InstanceInput {
					SourceOp = "Testo",
					Source = "Green4",
					ControlGroup = 4,
				},
				Input9 = InstanceInput {
					SourceOp = "Testo",
					Source = "Blue4",
					ControlGroup = 4,
				},
				Input10 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Center",
					Name = "Posizione",
				},
				Input11 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "WordDur",
				},
				Input12 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "OneWord",
				},
				Input13 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Pop",
				},
				Input14 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Box",
				},
				Input15 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Shadow",
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Ctrl",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				Sorgente = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "Scrivi qui la frase che vuoi far apparire parola per parola", },
						Font = Input { Value = "Optima", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.075, },
						VerticalJustificationNew = Input { Value = 3, },
						HorizontalJustificationNew = Input { Value = 3, },
						Center = Input { Value = { 0.5, 0.5 }, },
						Red1 = Input { Value = 0.961, },
						Green1 = Input { Value = 0.937, },
						Blue1 = Input { Value = 0.902, },
						ElementShape1 = Input { Value = 0, },
						CharacterSpacing = Input { Value = 1, },
						Enabled3 = Input {
							Expression = "Ctrl.Shadow",
						},
						ElementShape3 = Input { Value = 0, },
						Red3 = Input { Value = 0, },
						Green3 = Input { Value = 0, },
						Blue3 = Input { Value = 0, },
						Alpha3 = Input { Value = 0.55, },
						Offset3 = Input { Value = { 0, -0.004 }, },
						Softness3 = Input { Value = 1, },
						SoftnessX3 = Input { Value = 10, },
						SoftnessY3 = Input { Value = 10, },
						PriorityBack3 = Input { Value = 5, },
						PriorityBack1 = Input { Value = 10, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Testo = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input {
							Expression = ":local s=Sorgente.StyledText.Value or ''\nlocal w={}\nfor x in string.gmatch(s,'%S+') do w[#w+1]=x end\nlocal k=floor((time-comp.RenderStart)/max(Ctrl.WordDur,1))+1\nif k>#w then k=#w end\nif k<1 then return Text('') end\nif Ctrl.OneWord>0.5 then return Text(w[k]) end\nreturn Text(table.concat(w,' ',1,k))",
						},
						Font = Input { Value = "Optima", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.075, },
						VerticalJustificationNew = Input { Value = 3, },
						HorizontalJustificationNew = Input { Value = 3, },
						Center = Input { Value = { 0.5, 0.5 }, },
						Red1 = Input { Value = 0.961, },
						Green1 = Input { Value = 0.937, },
						Blue1 = Input { Value = 0.902, },
						ElementShape1 = Input { Value = 0, },
						CharacterSpacing = Input { Value = 1, },
						Enabled3 = Input {
							Expression = "Ctrl.Shadow",
						},
						ElementShape3 = Input { Value = 0, },
						Red3 = Input { Value = 0, },
						Green3 = Input { Value = 0, },
						Blue3 = Input { Value = 0, },
						Alpha3 = Input { Value = 0.55, },
						Offset3 = Input { Value = { 0, -0.004 }, },
						Softness3 = Input { Value = 1, },
						SoftnessX3 = Input { Value = 10, },
						SoftnessY3 = Input { Value = 10, },
						PriorityBack3 = Input { Value = 5, },
						PriorityBack1 = Input { Value = 10, },
						Enabled4 = Input {
							Expression = "Ctrl.Box",
						},
						ElementShape4 = Input { Value = 2, },
						Level4 = Input { Value = 0, },
						Red4 = Input { Value = 0.71, },
						Green4 = Input { Value = 0.196, },
						Blue4 = Input { Value = 0.235, },
						Alpha4 = Input { Value = 1, },
						ExtendHorizontal4 = Input { Value = 0.18, },
						ExtendVertical4 = Input { Value = 0.12, },
						Round4 = Input { Value = 0.08, },
						PriorityBack4 = Input { Value = 3, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				Ctrl = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Canvas",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Testo",
							Source = "Output",
						},
						Center = Input { Value = { 0.5, 0.25 }, },
						PerformDepthMerge = Input { Value = 0, },
						Size = Input {
							Expression = ":local f=((time-comp.RenderStart)%max(WordDur,1))\nlocal a=min(max(f/3,0),1)\nlocal s=(1+2.6*((a)-1)^3+1.6*((a)-1)^2)\nif OneWord<0.5 then s=1 end\nreturn 1+(max(s,0)-1)*Pop",
						},
						Blend = Input {
							Expression = "min(max((comp.RenderEnd-time)/3,0),1)",
						},
						WordDur = Input { Value = 8, },
						OneWord = Input { Value = 1, },
						Pop = Input { Value = 1, },
						Box = Input { Value = 1, },
						Shadow = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
					UserControls = ordered() {
						WordDur = {
							LINKS_Name = "Frame per parola",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 8,
							INP_MinScale = 2,
							INP_MaxScale = 30,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 1,
							INP_MaxAllowed = 600,
						},
						OneWord = {
							LINKS_Name = "Una parola alla volta (altrimenti la frase si compone)",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Default = 1,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
						},
						Pop = {
							LINKS_Name = "Scatto della parola",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Box = {
							LINKS_Name = "Riquadro terracotta dietro al testo",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Default = 1,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
						},
						Shadow = {
							LINKS_Name = "Ombra per leggibilità su video",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Default = 1,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
	},
	ActiveTool = "LDF_Didascalie"
}
