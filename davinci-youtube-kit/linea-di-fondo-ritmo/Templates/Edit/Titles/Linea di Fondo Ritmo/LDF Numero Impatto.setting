						CountDur = Input { Value = 30, },
						Sep = Input { Value = 1, },
						Punch = Input { Value = 0.08, },
						Size = Input {
							Expression = ":local d=(time-comp.RenderStart)-CountDur\nlocal s=0.92+0.08*(1-(1-min(max(((time-comp.RenderStart)-(0)*Speed)/max((8)*Speed,1),0),1))^4)\nif d>=0 and d<8 then s=s*(1+Punch*sin(pi*d/8)) end\nreturn s",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 1100, 0 } },
