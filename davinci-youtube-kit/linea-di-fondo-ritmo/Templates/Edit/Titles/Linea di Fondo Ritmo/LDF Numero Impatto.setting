					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input {
							Expression = ":local p=min(max((time-comp.RenderStart)/max(Ctrl.CountDur,1),0),1)\nlocal v=Ctrl.From+(Ctrl.To-Ctrl.From)*(1-(1-p)^4)\nlocal n=floor(v+0.5)\nlocal neg=n<0\nlocal s=string.format('%d',math.abs(n))\nif Ctrl.Sep>0.5 then\n  s=string.reverse(s)\n  s=string.gsub(s,'(%d%d%d)','%1.')\n  s=string.reverse(s)\n  if string.sub(s,1,1)=='.' then s=string.sub(s,2) end\nend\nif neg then s='-'..s end\nreturn Text((Prefisso.StyledText.Value or '')..s..(Suffisso.StyledText.Value or ''))",
						},
						Font = Input { Value = "Optima", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.13, },
						VerticalJustificationNew = Input { Value = 3, },
