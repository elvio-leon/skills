						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Expression = "(1-(1-min(max(((time-comp.RenderStart)-(6)*Ctrl.Speed)/max((10)*Ctrl.Speed,1),0),1))^4)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 990, 0 } },
				},
				Ctrl = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Canvas",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Livello3",
							Source = "Output",
						},
						Center = Input { Value = { 0.5, 0.5 }, },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Expression = "min(max((comp.RenderEnd-time)/max(OutDur,1),0),1)",
						},
