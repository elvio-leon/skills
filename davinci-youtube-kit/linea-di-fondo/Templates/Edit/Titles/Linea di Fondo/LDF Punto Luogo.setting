						EffectMask = Input {
							SourceOp = "PuntoMask",
							Source = "Mask",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				AnelloEst = EllipseMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input {
							Expression = "PuntoMask.Center",
						},
						Width = Input {
							Expression = "2*((10+50*(1-(1-(((time-comp.RenderStart)%60)/60))^3))+1.5)/Ctrl.Background.OriginalWidth",
						},
						Height = Input {
							Expression = "2*((10+50*(1-(1-(((time-comp.RenderStart)%60)/60))^3))+1.5)/Ctrl.Background.OriginalHeight",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
				},
				AnelloInt = EllipseMask {
