						ElementShape1 = Input { Value = 0, },
						CharacterSpacing = Input { Value = 1.15, },
						HorizontalLeftCenterRight = Input { Value = -1, },
					},
					ViewInfo = OperatorInfo { Pos = { 770, 0 } },
				},
				Livello1 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Canvas",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Anello",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Expression = "Ctrl.Pulse*(1-(((time-comp.RenderStart)%60)/60))*0.8*min(max(((time-comp.RenderStart)-(12)*Ctrl.Speed)/max((10)*Ctrl.Speed,1),0),1)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 880, 0 } },
				},
				Livello2 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Livello1",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Punto",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
