							SourceOp = "Coord",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Expression = "(1-(1-min(max(((time-comp.RenderStart)-(16)*Ctrl.Speed)/max((18)*Ctrl.Speed,1),0),1))^3)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 1210, 0 } },
				},
				Ctrl = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Canvas",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Livello4",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
