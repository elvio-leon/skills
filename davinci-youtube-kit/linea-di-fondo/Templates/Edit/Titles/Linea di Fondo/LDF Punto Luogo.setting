					Name = "Coordinate",
				},
				Input4 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Speed",
				},
				Input5 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "OutDur",
				},
				Input6 = InstanceInput {
					SourceOp = "Ctrl",
