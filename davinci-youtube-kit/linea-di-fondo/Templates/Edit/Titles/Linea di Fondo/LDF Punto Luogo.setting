						Width = Input {
							Expression = "(14)*((1-(1-min(max(((time-comp.RenderStart)-(0)*Ctrl.Speed)/max((12)*Ctrl.Speed,1),0),1))^3))/Ctrl.Background.OriginalWidth",
						},
						Height = Input {
							Expression = "(14)*((1-(1-min(max(((time-comp.RenderStart)-(0)*Ctrl.Speed)/max((12)*Ctrl.Speed,1),0),1))^3))/Ctrl.Background.OriginalHeight",
						},
						SoftEdge = Input { Value = 0.0006, },
