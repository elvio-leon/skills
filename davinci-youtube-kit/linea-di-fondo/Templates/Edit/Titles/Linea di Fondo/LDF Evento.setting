					SourceOp = "Ctrl",
					Source = "GreenBg",
				},
				Input11 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Year",
				},
				Input12 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Count",
				},
				Input13 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "CountFrom",
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Ctrl",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				SfondoVerde = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.094, },
						TopLeftGreen = Input { Value = 0.227, },
						TopLeftBlue = Input { Value = 0.184, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Anno = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input {
							Expression = ":local y=Ctrl.Year\nif Ctrl.Count>0.5 then y=Ctrl.Year-Ctrl.CountFrom*(1-(1-(1-min(max(((time-comp.RenderStart)-(0)*Ctrl.Speed)/max((40)*Ctrl.Speed,1),0),1))^3)) end\nreturn Text(string.format('%d', floor(y+0.5)))",
						},
						Font = Input { Value = "Optima", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.13, },
						VerticalJustificationNew = Input { Value = 3, },
						HorizontalJustificationNew = Input { Value = 3, },
						Center = Input {
							Expression = "Point(0.08, 0.58-(1-(1-(1-min(max(((time-comp.RenderStart)-(0)*Ctrl.Speed)/max((26)*Ctrl.Speed,1),0),1))^3))*0.02)",
						},
						Red1 = Input { Value = 0.961, },
						Green1 = Input { Value = 0.937, },
						Blue1 = Input { Value = 0.902, },
						ElementShape1 = Input { Value = 0, },
						CharacterSpacing = Input { Value = 1, },
						HorizontalLeftCenterRight = Input { Value = -1, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				LineaMask = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input {
							Expression = "Point(0.08+(0.12)*(((min(max(((time-comp.RenderStart)-(16)*Ctrl.Speed)/max((26)*Ctrl.Speed,1),0),1))<0.5 and 4*(min(max(((time-comp.RenderStart)-(16)*Ctrl.Speed)/max((26)*Ctrl.Speed,1),0),1))^3 or 1-((-2*(min(max(((time-comp.RenderStart)-(16)*Ctrl.Speed)/max((26)*Ctrl.Speed,1),0),1))+2)^3)/2))/2, 0.47)",
						},
						Width = Input {
							Expression = "(0.12)*(((min(max(((time-comp.RenderStart)-(16)*Ctrl.Speed)/max((26)*Ctrl.Speed,1),0),1))<0.5 and 4*(min(max(((time-comp.RenderStart)-(16)*Ctrl.Speed)/max((26)*Ctrl.Speed,1),0),1))^3 or 1-((-2*(min(max(((time-comp.RenderStart)-(16)*Ctrl.Speed)/max((26)*Ctrl.Speed,1),0),1))+2)^3)/2))",
						},
						Height = Input {
							Expression = "(4)/Ctrl.Background.OriginalHeight",
						},
						SoftEdge = Input { Value = 0.0003, },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
				},
				Linea = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.71, },
						TopLeftGreen = Input { Value = 0.196, },
						TopLeftBlue = Input { Value = 0.235, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input {
							SourceOp = "LineaMask",
							Source = "Mask",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
				},
				Evento = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "UN MONDIALE\nDUE MONDI", },
						Font = Input { Value = "Optima", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.034, },
						VerticalJustificationNew = Input { Value = 3, },
						HorizontalJustificationNew = Input { Value = 3, },
						Center = Input {
							Expression = "Point(0.08, 0.39-(1-(1-(1-min(max(((time-comp.RenderStart)-(28)*Ctrl.Speed)/max((22)*Ctrl.Speed,1),0),1))^3))*0.012)",
						},
						Red1 = Input { Value = 0.961, },
						Green1 = Input { Value = 0.937, },
						Blue1 = Input { Value = 0.902, },
						ElementShape1 = Input { Value = 0, },
						CharacterSpacing = Input { Value = 1, },
						HorizontalLeftCenterRight = Input { Value = -1, },
						LineSpacing = Input { Value = 1.05, },
					},
					ViewInfo = OperatorInfo { Pos = { 550, 0 } },
				},
				Livello1 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Canvas",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "SfondoVerde",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Expression = "Ctrl.GreenBg",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 660, 0 } },
				},
				Livello2 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Livello1",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Anno",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Expression = "(1-(1-min(max(((time-comp.RenderStart)-(0)*Ctrl.Speed)/max((20)*Ctrl.Speed,1),0),1))^3)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 770, 0 } },
				},
				Livello3 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Livello2",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Linea",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 880, 0 } },
				},
				Livello4 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Livello3",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Evento",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Expression = "(1-(1-min(max(((time-comp.RenderStart)-(28)*Ctrl.Speed)/max((22)*Ctrl.Speed,1),0),1))^3)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 990, 0 } },
				},
				Ctrl = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Canvas",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Livello4",
							Source = "Output",
						},
						Center = Input { Value = { 0.5, 0.5 }, },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Expression = "min(max((comp.RenderEnd-time)/max(Ctrl.OutDur,1),0),1)",
						},
						Speed = Input { Value = 1, },
						OutDur = Input { Value = 15, },
						GreenBg = Input { Value = 0, },
						Year = Input { Value = 1986, },
						Count = Input { Value = 0, },
						CountFrom = Input { Value = 30, },
