							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0.3,
							INP_MaxScale = 3,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 0.05,
							INP_MaxAllowed = 20,
						},
						OutDur = {
							LINKS_Name = "Durata uscita (frame)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 15,
							INP_MinScale = 1,
							INP_MaxScale = 60,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 1,
							INP_MaxAllowed = 600,
						},
						GreenBg = {
							LINKS_Name = "Sfondo verde pieno (per schermate titolo)",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Default = 0,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
						},
						Year = {
							LINKS_Name = "Anno",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1986,
							INP_MinScale = 1850,
							INP_MaxScale = 2030,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 0,
							INP_MaxAllowed = 3000,
						},
						Count = {
							LINKS_Name = "L'anno scorre fino alla data (passaggio del tempo)",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Default = 0,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
						},
