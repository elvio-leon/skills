{
	Tools = ordered() {
		LDF_DipVerde = MacroOperator {
			Inputs = ordered() {
				MainInput1 = InstanceInput {
					SourceOp = "ClipA",
					Source = "Input",
					Name = "Clip in uscita",
				},
				MainInput2 = InstanceInput {
					SourceOp = "ClipB",
					Source = "Input",
					Name = "Clip in entrata",
				},
				Input1 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Line",
				},
				Input2 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Hold",
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Uscita",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				ClipA = Transform {
					CtrlWZoom = false,
					NameSet = true,
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				ClipB = Transform {
					CtrlWZoom = false,
					NameSet = true,
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Taglio = Dissolve {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "ClipA",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "ClipB",
							Source = "Output",
						},
						Mix = Input {
							Expression = "iif(Ctrl.Mix<0.5,0,1)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				Verde = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.094, },
						TopLeftGreen = Input { Value = 0.227, },
						TopLeftBlue = Input { Value = 0.184, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
				},
				LineaMask = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, },
						Width = Input {
							Expression = "0.3*((min(max((Ctrl.Mix-0.2)/0.45,0),1))<0.5 and 4*(min(max((Ctrl.Mix-0.2)/0.45,0),1))^3 or 1-((-2*(min(max((Ctrl.Mix-0.2)/0.45,0),1))+2)^3)/2)",
						},
						Height = Input {
							Expression = "4/ClipA.Input.OriginalHeight",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
				},
				Linea = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.71, },
						TopLeftGreen = Input { Value = 0.196, },
						TopLeftBlue = Input { Value = 0.235, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input {
							SourceOp = "LineaMask",
							Source = "Mask",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 550, 0 } },
				},
				VerdeLinea = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Verde",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Linea",
							Source = "Output",
						},
						Blend = Input {
							Expression = "Ctrl.Line",
						},
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 660, 0 } },
				},
				Uscita = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Taglio",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "VerdeLinea",
							Source = "Output",
						},
						Blend = Input {
							Expression = "((min(max((1-abs(2*Ctrl.Mix-1))/max(1-Ctrl.Hold,0.05),0),1))<0.5 and 4*(min(max((1-abs(2*Ctrl.Mix-1))/max(1-Ctrl.Hold,0.05),0),1))^3 or 1-((-2*(min(max((1-abs(2*Ctrl.Mix-1))/max(1-Ctrl.Hold,0.05),0),1))+2)^3)/2)",
						},
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 770, 0 } },
				},
				Ctrl = Dissolve {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Mix = Input {
							SourceOp = "CtrlCurve",
							Source = "Value",
						},
						Line = Input { Value = 1, },
						Hold = Input { Value = 0.3, },
					},
					ViewInfo = OperatorInfo { Pos = { 880, 0 } },
					UserControls = ordered() {
						Line = {
							LINKS_Name = "Linea terracotta al centro",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Default = 1,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
						},
						Hold = {
							LINKS_Name = "Tenuta sul verde",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.3,
							INP_MinScale = 0,
							INP_MaxScale = 0.8,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				CtrlCurve = LUTLookup {
					Inputs = {
						Source = Input { Value = FuID { "Duration" }, },
						Lookup = Input {
							SourceOp = "CtrlCurveLookup",
							Source = "Value",
						},
					},
				},
				CtrlCurveLookup = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							[1] = { 1, LH = { 0.666666666666667, 0.666666666666667 }, Flags = { Linear = true } }
						}
					},
					SplineColor = { Red = 255, Green = 255, Blue = 255 },
				},
			},
		},
	},
	ActiveTool = "LDF_DipVerde"
}
