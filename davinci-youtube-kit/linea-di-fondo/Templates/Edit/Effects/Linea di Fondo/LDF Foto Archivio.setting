{
	Tools = ordered() {
		LDF_FotoArchivio = MacroOperator {
			Inputs = ordered() {
				MainInput1 = InstanceInput {
					SourceOp = "Foto",
					Source = "Input",
					Name = "Input",
				},
				Input1 = InstanceInput {
					SourceOp = "Foto",
					Source = "Center",
					Name = "Posizione foto",
				},
				Input2 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Scale",
				},
				Input3 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Tilt",
				},
				Input4 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Border",
				},
				Input5 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Drift",
				},
				Input6 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "GreenBg",
				},
				Input7 = InstanceInput {
					SourceOp = "Bordo",
					Source = "TopLeftRed",
					Name = "Colore bordo",
					ControlGroup = 1,
				},
				Input8 = InstanceInput {
					SourceOp = "Bordo",
					Source = "TopLeftGreen",
					ControlGroup = 1,
				},
				Input9 = InstanceInput {
					SourceOp = "Bordo",
					Source = "TopLeftBlue",
					ControlGroup = 1,
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Ctrl",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Foto = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Size = Input {
							Expression = "Ctrl.Scale",
						},
						Angle = Input {
							Expression = "Ctrl.Tilt",
						},
						Center = Input { Value = { 0.5, 0.5 }, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				Verde = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input {
							Expression = "0.094*Ctrl.GreenBg",
						},
						TopLeftGreen = Input {
							Expression = "0.227*Ctrl.GreenBg",
						},
						TopLeftBlue = Input {
							Expression = "0.184*Ctrl.GreenBg",
						},
						TopLeftAlpha = Input {
							Expression = "Ctrl.GreenBg",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				BordoMask = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input {
							Expression = "Foto.Center",
						},
						Angle = Input {
							Expression = "Ctrl.Tilt",
						},
						Width = Input {
							Expression = "Ctrl.Scale+2*Ctrl.Border/Foto.Input.OriginalWidth",
						},
						Height = Input {
							Expression = "Ctrl.Scale+2*Ctrl.Border/Foto.Input.OriginalHeight",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				Bordo = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.961, },
						TopLeftGreen = Input { Value = 0.937, },
						TopLeftBlue = Input { Value = 0.902, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input {
							SourceOp = "BordoMask",
							Source = "Mask",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
				},
				ConBordo = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Verde",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Bordo",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
				},
				ConFoto = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "ConBordo",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Foto",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 550, 0 } },
				},
				Ctrl = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input {
							SourceOp = "ConFoto",
							Source = "Output",
						},
						Size = Input {
							Expression = "1+Drift*((min(max((time-comp.RenderStart)/max(comp.RenderEnd-comp.RenderStart,1),0),1))<0.5 and 4*(min(max((time-comp.RenderStart)/max(comp.RenderEnd-comp.RenderStart,1),0),1))^3 or 1-((-2*(min(max((time-comp.RenderStart)/max(comp.RenderEnd-comp.RenderStart,1),0),1))+2)^3)/2)",
						},
						Center = Input {
							Expression = "Point(0.5-Drift*0.25*((min(max((time-comp.RenderStart)/max(comp.RenderEnd-comp.RenderStart,1),0),1))<0.5 and 4*(min(max((time-comp.RenderStart)/max(comp.RenderEnd-comp.RenderStart,1),0),1))^3 or 1-((-2*(min(max((time-comp.RenderStart)/max(comp.RenderEnd-comp.RenderStart,1),0),1))+2)^3)/2), 0.5)",
						},
						Scale = Input { Value = 0.7, },
						Tilt = Input { Value = -1.5, },
						Border = Input { Value = 14, },
						Drift = Input { Value = 0.04, },
						GreenBg = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 660, 0 } },
					UserControls = ordered() {
						Scale = {
							LINKS_Name = "Dimensione foto",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.7,
							INP_MinScale = 0.3,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Tilt = {
							LINKS_Name = "Rotazione (gradi)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = -1.5,
							INP_MinScale = -8,
							INP_MaxScale = 8,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Border = {
							LINKS_Name = "Bordo carta (pixel)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 14,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Drift = {
							LINKS_Name = "Movimento lento",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.04,
							INP_MinScale = 0,
							INP_MaxScale = 0.15,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						GreenBg = {
							LINKS_Name = "Sfondo verde (altrimenti trasparente)",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Default = 1,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
	},
	ActiveTool = "LDF_FotoArchivio"
}
