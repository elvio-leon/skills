{
	Tools = ordered() {
		YTK_Spin = MacroOperator {
			Inputs = ordered() {
				MainInput1 = InstanceInput {
					SourceOp = "ClipA",
					Source = "Input",
					Name = "Clip in uscita",
				},
				MainInput2 = InstanceInput {
					SourceOp = "ClipB",
					Source = "Input",
					Name = "Clip in entrata",
				},
				Input1 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Turns",
				},
				Input2 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Zoom",
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Taglio",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				ClipA = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Angle = Input {
							Expression = "-Ctrl.Turns/2*((min(max(Ctrl.Mix*2,0),1))^3)",
						},
						Size = Input {
							Expression = "1+Ctrl.Zoom*((min(max(Ctrl.Mix*2,0),1))^3)",
						},
						Edges = Input { Value = 3, },
						MotionBlur = Input { Value = 1, },
						Quality = Input { Value = 8, },
						ShutterAngle = Input { Value = 180, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				ClipB = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Angle = Input {
							Expression = "Ctrl.Turns/2*(1-(1-(1-min(max(Ctrl.Mix*2-1,0),1))^3))",
						},
						Size = Input {
							Expression = "1+Ctrl.Zoom*(1-(1-(1-min(max(Ctrl.Mix*2-1,0),1))^3))",
						},
						Edges = Input { Value = 3, },
						MotionBlur = Input { Value = 1, },
						Quality = Input { Value = 8, },
						ShutterAngle = Input { Value = 180, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Taglio = Dissolve {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "ClipA",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "ClipB",
							Source = "Output",
						},
						Mix = Input {
							Expression = "min(max((Ctrl.Mix-0.5+0.04)/0.08,0),1)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				Ctrl = Dissolve {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Mix = Input {
							SourceOp = "CtrlCurve",
							Source = "Value",
						},
						Turns = Input { Value = 180, },
						Zoom = Input { Value = 0.4, },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
					UserControls = ordered() {
						Turns = {
							LINKS_Name = "Rotazione (gradi)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 180,
							INP_MinScale = 45,
							INP_MaxScale = 720,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Zoom = {
							LINKS_Name = "Zoom",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.4,
							INP_MinScale = 0,
							INP_MaxScale = 2,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				CtrlCurve = LUTLookup {
					Inputs = {
						Source = Input { Value = FuID { "Duration" }, },
						Lookup = Input {
							SourceOp = "CtrlCurveLookup",
							Source = "Value",
						},
					},
				},
				CtrlCurveLookup = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							[1] = { 1, LH = { 0.666666666666667, 0.666666666666667 }, Flags = { Linear = true } }
						}
					},
					SplineColor = { Red = 255, Green = 255, Blue = 255 },
				},
			},
		},
	},
	ActiveTool = "YTK_Spin"
}
