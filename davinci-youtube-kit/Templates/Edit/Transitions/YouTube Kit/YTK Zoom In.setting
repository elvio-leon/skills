{
	Tools = ordered() {
		YTK_ZoomIn = MacroOperator {
			Inputs = ordered() {
				MainInput1 = InstanceInput {
					SourceOp = "ClipA",
					Source = "Input",
					Name = "Clip in uscita",
				},
				MainInput2 = InstanceInput {
					SourceOp = "ClipB",
					Source = "Input",
					Name = "Clip in entrata",
				},
				Input1 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Zoom",
				},
				Input2 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Blur",
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "ZoomBlur",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				ClipA = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Size = Input {
							Expression = "1+Ctrl.Zoom*((min(max(Ctrl.Mix*2,0),1))^3)",
						},
						Edges = Input { Value = 3, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				ClipB = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Size = Input {
							Expression = "1/(1+Ctrl.Zoom*(1-(1-(1-min(max(Ctrl.Mix*2-1,0),1))^3)))",
						},
						Edges = Input { Value = 3, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Taglio = Dissolve {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "ClipA",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "ClipB",
							Source = "Output",
						},
						Mix = Input {
							Expression = "min(max((Ctrl.Mix-0.5+0.04)/0.08,0),1)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				ZoomBlur = DirectionalBlur {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input {
							SourceOp = "Taglio",
							Source = "Output",
						},
						Type = Input { Value = 3, },
						Center = Input { Value = { 0.5, 0.5 }, },
						Length = Input {
							Expression = "Ctrl.Blur*0.6*sin(pi*Ctrl.Mix)^2",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
				},
				Ctrl = Dissolve {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Mix = Input {
							SourceOp = "CtrlCurve",
							Source = "Value",
						},
						Zoom = Input { Value = 1.5, },
						Blur = Input { Value = 0.25, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						Zoom = {
							LINKS_Name = "Intensità zoom",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1.5,
							INP_MinScale = 0.2,
							INP_MaxScale = 4,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Blur = {
							LINKS_Name = "Sfocatura zoom",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.25,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				CtrlCurve = LUTLookup {
					Inputs = {
						Source = Input { Value = FuID { "Duration" }, },
						Lookup = Input {
							SourceOp = "CtrlCurveLookup",
							Source = "Value",
						},
					},
				},
				CtrlCurveLookup = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							[1] = { 1, LH = { 0.666666666666667, 0.666666666666667 }, Flags = { Linear = true } }
						}
					},
					SplineColor = { Red = 255, Green = 255, Blue = 255 },
				},
			},
		},
	},
	ActiveTool = "YTK_ZoomIn"
}
