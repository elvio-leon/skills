				Ctrl = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Canvas",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Testo",
							Source = "Output",
						},
						Center = Input { Value = { 0.5, 0.5 }, },
						PerformDepthMerge = Input { Value = 0, },
						Size = Input {
							Expression = ":local a=min(max((time-comp.RenderStart)/max(InDur,1),0),1)\nlocal b=min(max((comp.RenderEnd-time)/max(OutDur,1),0),1)\nlocal s=1+(Overshoot+1)*(a-1)^3+Overshoot*(a-1)^2\nreturn max(s,0)*(1-(1-b)^3)",
						},
						InDur = Input { Value = 10, },
						OutDur = Input { Value = 8, },
						Overshoot = Input { Value = 1.7, },
