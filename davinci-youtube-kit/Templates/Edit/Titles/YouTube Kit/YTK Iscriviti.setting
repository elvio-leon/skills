{
	Tools = ordered() {
		YTK_Iscriviti = MacroOperator {
			Inputs = ordered() {
				Input1 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Testo1",
				},
				Input2 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Testo2",
				},
				Input3 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Red",
					ControlGroup = 1,
				},
				Input4 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Green",
					ControlGroup = 1,
				},
				Input5 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Blue",
					ControlGroup = 1,
				},
				Input6 = InstanceInput {
					SourceOp = "Etichetta",
					Source = "Font",
					Name = "Font",
				},
				Input7 = InstanceInput {
					SourceOp = "Etichetta",
					Source = "Style",
					Name = "Stile",
				},
				Input8 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Center",
					Name = "Posizione",
				},
				Input9 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "InDur",
				},
				Input10 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "OutDur",
				},
				Input11 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "ClickAt",
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Ctrl",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				BtnMask = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, },
						Width = Input { Value = 0.2, },
						Height = Input { Value = 0.1, },
						CornerRadius = Input { Value = 0.35, },
						SoftEdge = Input { Value = 0.0005, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Bottone = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input {
							Expression = "iif(((time-comp.RenderStart)>=Ctrl.ClickAt), 0.35, Ctrl.Red)",
						},
						TopLeftGreen = Input {
							Expression = "iif(((time-comp.RenderStart)>=Ctrl.ClickAt), 0.35, Ctrl.Green)",
						},
						TopLeftBlue = Input {
							Expression = "iif(((time-comp.RenderStart)>=Ctrl.ClickAt), 0.35, Ctrl.Blue)",
						},
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input {
							SourceOp = "BtnMask",
							Source = "Mask",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				Etichetta = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input {
							Expression = ":if ((time-comp.RenderStart)>=Ctrl.ClickAt) then return Ctrl.Testo2 end\nreturn Ctrl.Testo1",
						},
						Font = Input { Value = "Arial", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.05, },
						VerticalJustificationNew = Input { Value = 3, },
						HorizontalJustificationNew = Input { Value = 3, },
						Center = Input { Value = { 0.5, 0.5 }, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						ElementShape1 = Input { Value = 0, },
						PriorityBack1 = Input { Value = 10, },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
				},
				Pulsante = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Bottone",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Etichetta",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
				},
				Ctrl = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Canvas",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Pulsante",
							Source = "Output",
						},
						Center = Input { Value = { 0.5, 0.18 }, },
						PerformDepthMerge = Input { Value = 0, },
						Size = Input {
							Expression = ":local a=min(max((time-comp.RenderStart)/max(InDur,1),0),1)\nlocal b=min(max((comp.RenderEnd-time)/max(OutDur,1),0),1)\nlocal s=max((1+2.70158*((a)-1)^3+1.70158*((a)-1)^2),0)*(1-(1-b)^3)\nlocal d=(time-comp.RenderStart)-ClickAt\nif d>=0 and d<6 then s=s*(1-0.12*sin(pi*d/6)) end\nreturn s",
						},
						InDur = Input { Value = 10, },
						OutDur = Input { Value = 8, },
						ClickAt = Input { Value = 40, },
						Testo1 = Input { Value = "ISCRIVITI", },
						Testo2 = Input { Value = "ISCRITTO", },
						Red = Input { Value = 0.9, },
						Green = Input { Value = 0.05, },
						Blue = Input { Value = 0.05, },
					},
					ViewInfo = OperatorInfo { Pos = { 550, 0 } },
					UserControls = ordered() {
						InDur = {
							LINKS_Name = "Durata entrata (frame)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 10,
							INP_MinScale = 1,
							INP_MaxScale = 60,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 0,
							INP_MaxAllowed = 600,
						},
						OutDur = {
							LINKS_Name = "Durata uscita (frame)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 8,
							INP_MinScale = 1,
							INP_MaxScale = 60,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 0,
							INP_MaxAllowed = 600,
						},
						ClickAt = {
							LINKS_Name = "Click dopo (frame)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 40,
							INP_MinScale = 0,
							INP_MaxScale = 150,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 0,
							INP_MaxAllowed = 3000,
						},
						Testo1 = {
							LINKS_Name = "Testo prima del click",
							LINKID_DataType = "Text",
							INPID_InputControl = "TextEditControl",
							TEC_Lines = 1,
							ICS_ControlPage = "Controls",
						},
						Testo2 = {
							LINKS_Name = "Testo dopo il click",
							LINKID_DataType = "Text",
							INPID_InputControl = "TextEditControl",
							TEC_Lines = 1,
							ICS_ControlPage = "Controls",
						},
						Red = {
							LINKS_Name = "Colore pulsante",
							LINKID_DataType = "Number",
							INPID_InputControl = "ColorControl",
							INP_Default = 0.9,
							IC_ControlGroup = 1,
							IC_ControlID = 0,
							ICS_ControlPage = "Controls",
						},
						Green = {
							LINKID_DataType = "Number",
							INPID_InputControl = "ColorControl",
							INP_Default = 0.05,
							IC_ControlGroup = 1,
							IC_ControlID = 1,
							ICS_ControlPage = "Controls",
						},
						Blue = {
							LINKID_DataType = "Number",
							INPID_InputControl = "ColorControl",
							INP_Default = 0.05,
							IC_ControlGroup = 1,
							IC_ControlID = 2,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
	},
	ActiveTool = "YTK_Iscriviti"
}
