{
	Tools = ordered() {
		YTK_MacchinaDaScrivere = MacroOperator {
			Inputs = ordered() {
				Input1 = InstanceInput {
					SourceOp = "Testo",
					Source = "StyledText",
					Name = "Testo",
				},
				Input2 = InstanceInput {
					SourceOp = "Testo",
					Source = "Font",
					Name = "Font",
				},
				Input3 = InstanceInput {
					SourceOp = "Testo",
					Source = "Style",
					Name = "Stile",
				},
				Input4 = InstanceInput {
					SourceOp = "Testo",
					Source = "Size",
					Name = "Dimensione testo",
					Default = 0.06,
				},
				Input5 = InstanceInput {
					SourceOp = "Testo",
					Source = "Red1",
					Name = "Colore testo",
					ControlGroup = 1,
				},
				Input6 = InstanceInput {
					SourceOp = "Testo",
					Source = "Green1",
					ControlGroup = 1,
				},
				Input7 = InstanceInput {
					SourceOp = "Testo",
					Source = "Blue1",
					ControlGroup = 1,
				},
				Input8 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Center",
					Name = "Posizione",
				},
				Input9 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "TypeDur",
				},
				Input10 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "EraseOut",
				},
				Input11 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "OutDur",
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Ctrl",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				Testo = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "Scrivi qui il tuo testo", },
						Font = Input { Value = "Courier New", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.06, },
						VerticalJustificationNew = Input { Value = 3, },
						HorizontalJustificationNew = Input { Value = 3, },
						Center = Input { Value = { 0.5, 0.5 }, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						ElementShape1 = Input { Value = 0, },
						PriorityBack1 = Input { Value = 10, },
						Enabled3 = Input { Value = 1, },
						ElementShape3 = Input { Value = 0, },
						Red3 = Input { Value = 0, },
						Green3 = Input { Value = 0, },
						Blue3 = Input { Value = 0, },
						Alpha3 = Input { Value = 0.55, },
						Offset3 = Input { Value = { 0.012, -0.018 }, },
						Softness3 = Input { Value = 1, },
						SoftnessX3 = Input { Value = 6, },
						SoftnessY3 = Input { Value = 6, },
						PriorityBack3 = Input { Value = 5, },
						End = Input {
							Expression = ":local a=min(max((time-comp.RenderStart)/max(Ctrl.TypeDur,1),0),1)\nlocal b=1\nif Ctrl.EraseOut>0.5 then b=min(max((comp.RenderEnd-time)/max(Ctrl.OutDur,1),0),1) end\nreturn min(a,b)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Ctrl = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Canvas",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Testo",
							Source = "Output",
						},
						Center = Input { Value = { 0.5, 0.5 }, },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Expression = "iif(EraseOut>0.5, 1, min(max((comp.RenderEnd-time)/max(OutDur,1),0),1))",
						},
						TypeDur = Input { Value = 45, },
						EraseOut = Input { Value = 0, },
						OutDur = Input { Value = 12, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
					UserControls = ordered() {
						TypeDur = {
							LINKS_Name = "Durata scrittura (frame)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 45,
							INP_MinScale = 5,
							INP_MaxScale = 240,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 1,
							INP_MaxAllowed = 3000,
						},
						EraseOut = {
							LINKS_Name = "Cancella lettera per lettera alla fine",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Default = 0,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
						},
						OutDur = {
							LINKS_Name = "Durata uscita (frame)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 12,
							INP_MinScale = 1,
							INP_MaxScale = 60,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 1,
							INP_MaxAllowed = 600,
						},
					},
				},
			},
		},
	},
	ActiveTool = "YTK_MacchinaDaScrivere"
}
