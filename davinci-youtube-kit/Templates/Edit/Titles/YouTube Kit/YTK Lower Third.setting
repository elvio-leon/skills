						Font = Input { Value = "Arial", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.035, },
						VerticalJustificationNew = Input { Value = 3, },
						HorizontalJustificationNew = Input { Value = 3, },
						Center = Input {
							Expression = ":local a=min(max(((time-comp.RenderStart)-4)/max(Ctrl.InDur,1),0),1)\nlocal b=min(max(((comp.RenderEnd-time)-4)/max(Ctrl.OutDur,1),0),1)\nlocal e=min((1-(1-a)^3),(1-(1-b)^3))\nreturn Point(0.5-(1-e)*0.8, 0.455)",
						},
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						ElementShape1 = Input { Value = 0, },
						PriorityBack1 = Input { Value = 10, },
						Enabled4 = Input { Value = 1, },
						ElementShape4 = Input { Value = 2, },
