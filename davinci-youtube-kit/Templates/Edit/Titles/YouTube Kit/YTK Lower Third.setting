						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.055, },
						VerticalJustificationNew = Input { Value = 3, },
						HorizontalJustificationNew = Input { Value = 3, },
						Center = Input {
							Expression = ":local a=min(max(((time-comp.RenderStart)-0)/max(Ctrl.InDur,1),0),1)\nlocal b=min(max(((comp.RenderEnd-time)-0)/max(Ctrl.OutDur,1),0),1)\nlocal e=min((1-(1-a)^3),(1-(1-b)^3))\nreturn Point(0.5-(1-e)*0.8, 0.535)",
						},
						Red1 = Input { Value = 0.05, },
						Green1 = Input { Value = 0.05, },
						Blue1 = Input { Value = 0.05, },
