						PriorityBack1 = Input { Value = 10, },
						Enabled4 = Input { Value = 1, },
						ElementShape4 = Input { Value = 2, },
						Level4 = Input { Value = 0, },
						Red4 = Input { Value = 1, },
						Green4 = Input { Value = 0.8, },
						Blue4 = Input { Value = 0.05, },
						Alpha4 = Input { Value = 1, },
						ExtendHorizontal4 = Input { Value = 0.3, },
						ExtendVertical4 = Input { Value = 0.25, },
						Round4 = Input { Value = 0.1, },
						PriorityBack4 = Input { Value = 3, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Ruolo = TextPlus {
					CtrlWZoom = false,
