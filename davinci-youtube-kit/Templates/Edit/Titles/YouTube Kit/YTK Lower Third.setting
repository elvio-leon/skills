						ExtendVertical4 = Input { Value = 0.3, },
						Round4 = Input { Value = 0.1, },
						PriorityBack4 = Input { Value = 3, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				Blocco = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Canvas",
							Source = "Output",
						},
