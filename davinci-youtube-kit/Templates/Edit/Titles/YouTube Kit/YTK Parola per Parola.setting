{
	Tools = ordered() {
		YTK_ParolaPerParola = MacroOperator {
			Inputs = ordered() {
				Input1 = InstanceInput {
					SourceOp = "Sorgente",
					Source = "StyledText",
					Name = "Frase",
				},
				Input2 = InstanceInput {
					SourceOp = "Testo",
					Source = "Font",
					Name = "Font",
				},
				Input3 = InstanceInput {
					SourceOp = "Testo",
					Source = "Style",
					Name = "Stile",
				},
				Input4 = InstanceInput {
					SourceOp = "Testo",
					Source = "Size",
					Name = "Dimensione testo",
					Default = 0.09,
				},
				Input5 = InstanceInput {
					SourceOp = "Testo",
					Source = "Red1",
					Name = "Colore testo",
					ControlGroup = 1,
				},
				Input6 = InstanceInput {
					SourceOp = "Testo",
					Source = "Green1",
					ControlGroup = 1,
				},
				Input7 = InstanceInput {
					SourceOp = "Testo",
					Source = "Blue1",
					ControlGroup = 1,
				},
				Input8 = InstanceInput {
					SourceOp = "Testo",
					Source = "Thickness2",
					Name = "Spessore contorno",
				},
				Input9 = InstanceInput {
					SourceOp = "Testo",
					Source = "Red2",
					Name = "Colore contorno",
					ControlGroup = 2,
				},
				Input10 = InstanceInput {
					SourceOp = "Testo",
					Source = "Green2",
					ControlGroup = 2,
				},
				Input11 = InstanceInput {
					SourceOp = "Testo",
					Source = "Blue2",
					ControlGroup = 2,
				},
				Input12 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Center",
					Name = "Posizione",
				},
				Input13 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "WordDur",
				},
				Input14 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "OneWord",
				},
				Input15 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Pop",
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Ctrl",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				Sorgente = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "Scrivi qui la frase che vuoi far apparire parola per parola", },
						Font = Input { Value = "Arial Black", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.09, },
						VerticalJustificationNew = Input { Value = 3, },
						HorizontalJustificationNew = Input { Value = 3, },
						Center = Input { Value = { 0.5, 0.5 }, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						ElementShape1 = Input { Value = 0, },
						PriorityBack1 = Input { Value = 10, },
						Enabled2 = Input { Value = 1, },
						ElementShape2 = Input { Value = 1, },
						OutsideOnly2 = Input { Value = 1, },
						Thickness2 = Input { Value = 0.08, },
						Red2 = Input { Value = 0, },
						Green2 = Input { Value = 0, },
						Blue2 = Input { Value = 0, },
						PriorityBack2 = Input { Value = 9, },
						Enabled3 = Input { Value = 1, },
						ElementShape3 = Input { Value = 0, },
						Red3 = Input { Value = 0, },
						Green3 = Input { Value = 0, },
						Blue3 = Input { Value = 0, },
						Alpha3 = Input { Value = 0.55, },
						Offset3 = Input { Value = { 0.012, -0.018 }, },
						Softness3 = Input { Value = 1, },
						SoftnessX3 = Input { Value = 6, },
						SoftnessY3 = Input { Value = 6, },
						PriorityBack3 = Input { Value = 5, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Testo = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input {
							Expression = ":local s=Sorgente.StyledText.Value or ''\nlocal w={}\nfor x in string.gmatch(s,'%S+') do w[#w+1]=x end\nlocal k=floor((time-comp.RenderStart)/max(Ctrl.WordDur,1))+1\nif k>#w then k=#w end\nif k<1 then return Text('') end\nif Ctrl.OneWord>0.5 then return Text(w[k]) end\nreturn Text(table.concat(w,' ',1,k))",
						},
						Font = Input { Value = "Arial Black", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.09, },
						VerticalJustificationNew = Input { Value = 3, },
						HorizontalJustificationNew = Input { Value = 3, },
						Center = Input { Value = { 0.5, 0.5 }, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 0.86, },
						Blue1 = Input { Value = 0.1, },
						ElementShape1 = Input { Value = 0, },
						PriorityBack1 = Input { Value = 10, },
						Enabled2 = Input { Value = 1, },
						ElementShape2 = Input { Value = 1, },
						OutsideOnly2 = Input { Value = 1, },
						Thickness2 = Input { Value = 0.08, },
						Red2 = Input { Value = 0, },
						Green2 = Input { Value = 0, },
						Blue2 = Input { Value = 0, },
						PriorityBack2 = Input { Value = 9, },
						Enabled3 = Input { Value = 1, },
						ElementShape3 = Input { Value = 0, },
						Red3 = Input { Value = 0, },
						Green3 = Input { Value = 0, },
						Blue3 = Input { Value = 0, },
						Alpha3 = Input { Value = 0.55, },
						Offset3 = Input { Value = { 0.012, -0.018 }, },
						Softness3 = Input { Value = 1, },
						SoftnessX3 = Input { Value = 6, },
						SoftnessY3 = Input { Value = 6, },
						PriorityBack3 = Input { Value = 5, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				Ctrl = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Canvas",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Testo",
							Source = "Output",
						},
						Center = Input { Value = { 0.5, 0.3 }, },
						PerformDepthMerge = Input { Value = 0, },
						Size = Input {
							Expression = ":local f=((time-comp.RenderStart)%max(WordDur,1))\nlocal a=min(max(f/3,0),1)\nlocal s=(1+3.2*((a)-1)^3+2.2*((a)-1)^2)\nif OneWord<0.5 then s=1 end\nreturn 1+(max(s,0)-1)*Pop",
						},
						Blend = Input {
							Expression = "min(max((comp.RenderEnd-time)/3,0),1)",
						},
						WordDur = Input { Value = 8, },
						OneWord = Input { Value = 1, },
						Pop = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
					UserControls = ordered() {
						WordDur = {
							LINKS_Name = "Frame per parola",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 8,
							INP_MinScale = 2,
							INP_MaxScale = 30,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INP_MinAllowed = 1,
							INP_MaxAllowed = 600,
						},
						OneWord = {
							LINKS_Name = "Mostra solo la parola corrente (stile Shorts)",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Default = 1,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
						},
						Pop = {
							LINKS_Name = "Rimbalzo parola",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
			},
		},
	},
	ActiveTool = "YTK_ParolaPerParola"
}
