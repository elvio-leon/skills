				},
				BuioMask = EllipseMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input {
							Expression = "Point((Schermo.Center.X*1920)/1920, 1-((1-Schermo.Center.Y)*1080)/1080)",
						},
						Width = Input {
							Expression = "(Ctrl.Radius*6.5)/1920",
						},
						Height = Input {
							Expression = "(Ctrl.Radius*6.5)/1080",
						},
						SoftEdge = Input { Value = 0.12, },
