{
	Tools = ordered() {
		MOV_ZoomSulDettaglio = MacroOperator {
			Inputs = ordered() {
				MainInput1 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Input",
					Name = "Input",
				},
				Input1 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Zoom",
				},
				Input2 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "ZStart",
				},
				Input3 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "ZDur",
				},
				Input4 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Mark",
				},
				Input5 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Radius",
				},
				Input6 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Dark",
				},
				Input7 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Tone",
				},
				Input8 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Vign",
				},
				Input9 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Grain",
				},
				Input10 = InstanceInput {
					SourceOp = "Fuoco",
					Source = "Pivot",
					Name = "Punto (trascinalo nel viewer)",
				},
				Input11 = InstanceInput {
					SourceOp = "Nota",
					Source = "StyledText",
					Name = "Nota scritta a mano (vuota = nessuna)",
				},
				Input12 = InstanceInput {
					SourceOp = "Cerchio",
					Source = "TopLeftRed",
					Name = "Colore segno",
					ControlGroup = 1,
				},
				Input13 = InstanceInput {
					SourceOp = "Cerchio",
					Source = "TopLeftGreen",
					ControlGroup = 1,
				},
				Input14 = InstanceInput {
					SourceOp = "Cerchio",
					Source = "TopLeftBlue",
					ControlGroup = 1,
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "D3",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Ctrl = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Size = Input {
							Expression = "(1+(Zoom-1)*((min(max(((time-comp.RenderStart)-ZStart)/max(ZDur,1),0),1))<0.5 and 4*(min(max(((time-comp.RenderStart)-ZStart)/max(ZDur,1),0),1))^3 or 1-((-2*(min(max(((time-comp.RenderStart)-ZStart)/max(ZDur,1),0),1))+2)^3)/2))",
						},
						Center = Input {
							Expression = ":local z=(1+(Zoom-1)*((min(max(((time-comp.RenderStart)-ZStart)/max(ZDur,1),0),1))<0.5 and 4*(min(max(((time-comp.RenderStart)-ZStart)/max(ZDur,1),0),1))^3 or 1-((-2*(min(max(((time-comp.RenderStart)-ZStart)/max(ZDur,1),0),1))+2)^3)/2))\nlocal px,py=Fuoco.Pivot.X,Fuoco.Pivot.Y\nlocal cx=0.5-(px-0.5)*z local cy=0.5-(py-0.5)*z\nlocal lim=(z-1)/2 cx=min(max(cx,0.5-lim),0.5+lim) cy=min(max(cy,0.5-lim),0.5+lim)\nreturn Point(cx,cy)",
						},
						Edges = Input { Value = 3, },
						Zoom = Input { Value = 2.4, },
						ZStart = Input { Value = 12, },
						ZDur = Input { Value = 60, },
						Mark = Input { Value = 0, },
						Radius = Input { Value = 170, },
						Dark = Input { Value = 0.6, },
						Tone = Input { Value = 1, },
						Vign = Input { Value = 0.45, },
						Grain = Input { Value = 0.35, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Zoom = {
							LINKS_Name = "Ingrandimento",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 2.4,
							INP_MinScale = 1,
							INP_MaxScale = 5,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						ZStart = {
							LINKS_Name = "Zoom parte al fotogramma",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 12,
							INP_MinScale = 0,
							INP_MaxScale = 300,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
						},
						ZDur = {
							LINKS_Name = "Durata zoom (fotogrammi)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 60,
							INP_MinScale = 1,
							INP_MaxScale = 300,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
						},
						Mark = {
							{ CCS_AddString = "Cerchio a mano" },
							{ CCS_AddString = "Riflettore" },
							{ CCS_AddString = "Nessuno" },
							LINKS_Name = "Segno",
							LINKID_DataType = "Number",
							INPID_InputControl = "ComboControl",
							INP_Default = 0,
							INP_Integer = true,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 2,
							CC_LabelPosition = "Horizontal",
							ICS_ControlPage = "Controls",
						},
						Radius = {
							LINKS_Name = "Dimensione segno (px)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 170,
							INP_MinScale = 40,
							INP_MaxScale = 500,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Dark = {
							LINKS_Name = "Scurisci il resto",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.6,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Tone = {
							{ CCS_AddString = "Originale" },
							{ CCS_AddString = "Bianco e nero" },
							{ CCS_AddString = "Seppia" },
							{ CCS_AddString = "Duotono verde" },
							LINKS_Name = "Tono",
							LINKID_DataType = "Number",
							INPID_InputControl = "ComboControl",
							INP_Default = 1,
							INP_Integer = true,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 3,
							CC_LabelPosition = "Horizontal",
							ICS_ControlPage = "Controls",
						},
						Vign = {
							LINKS_Name = "Vignetta",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.45,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Grain = {
							LINKS_Name = "Grana pellicola",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.35,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Fuoco = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Pivot = Input { Value = { 0.58, 0.4 }, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Schermo = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input {
							Expression = ":local z=(1+(Ctrl.Zoom-1)*((min(max(((time-comp.RenderStart)-Ctrl.ZStart)/max(Ctrl.ZDur,1),0),1))<0.5 and 4*(min(max(((time-comp.RenderStart)-Ctrl.ZStart)/max(Ctrl.ZDur,1),0),1))^3 or 1-((-2*(min(max(((time-comp.RenderStart)-Ctrl.ZStart)/max(Ctrl.ZDur,1),0),1))+2)^3)/2))\nlocal c=Ctrl.Center\nreturn Point((Fuoco.Pivot.X-0.5)*z+c.X, (Fuoco.Pivot.Y-0.5)*z+c.Y)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				Tono = BrightnessContrast {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input {
							SourceOp = "Ctrl",
							Source = "Output",
						},
						Saturation = Input {
							Expression = "Ctrl.Tone>0 and 0 or 1",
						},
						Contrast = Input {
							Expression = "Ctrl.Tone>0 and 0.12 or 0",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
				},
				TonoTinta = ColorGain {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input {
							SourceOp = "Tono",
							Source = "Output",
						},
						GainRed = Input {
							Expression = "Ctrl.Tone==2 and 1.08 or (Ctrl.Tone==3 and 0.78 or 1)",
						},
						GainGreen = Input {
							Expression = "Ctrl.Tone==2 and 0.98 or (Ctrl.Tone==3 and 1.0 or 1)",
						},
						GainBlue = Input {
							Expression = "Ctrl.Tone==2 and 0.82 or (Ctrl.Tone==3 and 0.86 or 1)",
