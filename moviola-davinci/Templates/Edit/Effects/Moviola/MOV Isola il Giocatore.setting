				},
				Piedi = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Pivot = Input { Value = { 0.47, 0.44 }, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Schermo = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input {
							Expression = ":local z=(1+(Ctrl.Push-1)*((min(max(((time-comp.RenderStart)-5)/55,0),1))<0.5 and 4*(min(max(((time-comp.RenderStart)-5)/55,0),1))^3 or 1-((-2*(min(max(((time-comp.RenderStart)-5)/55,0),1))+2)^3)/2))\nlocal c=Ctrl.Center return Point((Piedi.Pivot.X-0.5)*z+c.X,(Piedi.Pivot.Y-0.5)*z+c.Y)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
