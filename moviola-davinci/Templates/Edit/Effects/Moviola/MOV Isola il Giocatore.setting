{
	Tools = ordered() {
		MOV_IsolaGiocatore = MacroOperator {
			Inputs = ordered() {
				MainInput1 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Input",
					Name = "Input",
				},
				Input1 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Height",
				},
				Input2 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Dark",
				},
				Input3 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Push",
				},
				Input4 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Tone",
				},
				Input5 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Vign",
				},
				Input6 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Grain",
				},
				Input7 = InstanceInput {
					SourceOp = "Piedi",
					Source = "Pivot",
					Name = "Piedi del giocatore (trascina nel viewer)",
				},
				Input8 = InstanceInput {
					SourceOp = "Nome",
					Source = "StyledText",
					Name = "Nome",
				},
				Input9 = InstanceInput {
					SourceOp = "Ruolo",
					Source = "StyledText",
					Name = "Ruolo",
				},
				Input10 = InstanceInput {
					SourceOp = "Anello",
					Source = "TopLeftRed",
					Name = "Colore anello",
					ControlGroup = 1,
				},
				Input11 = InstanceInput {
					SourceOp = "Anello",
					Source = "TopLeftGreen",
					ControlGroup = 1,
				},
				Input12 = InstanceInput {
					SourceOp = "Anello",
					Source = "TopLeftBlue",
					ControlGroup = 1,
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "I7",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Ctrl = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Size = Input {
							Expression = "(1+(Push-1)*((min(max(((time-comp.RenderStart)-5)/55,0),1))<0.5 and 4*(min(max(((time-comp.RenderStart)-5)/55,0),1))^3 or 1-((-2*(min(max(((time-comp.RenderStart)-5)/55,0),1))+2)^3)/2))",
						},
						Center = Input {
							Expression = ":local z=(1+(Push-1)*((min(max(((time-comp.RenderStart)-5)/55,0),1))<0.5 and 4*(min(max(((time-comp.RenderStart)-5)/55,0),1))^3 or 1-((-2*(min(max(((time-comp.RenderStart)-5)/55,0),1))+2)^3)/2))\nlocal px,py=Piedi.Pivot.X,Piedi.Pivot.Y+0.04\nlocal cx,cy=0.5-(px-0.5)*z,0.5-(py-0.5)*z\nlocal lim=(z-1)/2 cx=min(max(cx,0.5-lim),0.5+lim) cy=min(max(cy,0.5-lim),0.5+lim)\nreturn Point(cx,cy)",
						},
						Edges = Input { Value = 3, },
						Height = Input { Value = 200, },
						Dark = Input { Value = 0.62, },
						Push = Input { Value = 1.2, },
						Tone = Input { Value = 1, },
						Vign = Input { Value = 0.45, },
						Grain = Input { Value = 0.35, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Height = {
							LINKS_Name = "Altezza del giocatore (px)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 200,
							INP_MinScale = 60,
							INP_MaxScale = 700,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Dark = {
							LINKS_Name = "Scurisci il resto",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.62,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Push = {
							LINKS_Name = "Avvicinamento",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1.2,
							INP_MinScale = 1,
							INP_MaxScale = 2,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Tone = {
							{ CCS_AddString = "Originale" },
							{ CCS_AddString = "Bianco e nero" },
							{ CCS_AddString = "Seppia" },
							{ CCS_AddString = "Duotono verde" },
							LINKS_Name = "Tono",
							LINKID_DataType = "Number",
							INPID_InputControl = "ComboControl",
							INP_Default = 1,
							INP_Integer = true,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 3,
							CC_LabelPosition = "Horizontal",
							ICS_ControlPage = "Controls",
						},
						Vign = {
							LINKS_Name = "Vignetta",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.45,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
						Grain = {
							LINKS_Name = "Grana pellicola",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.35,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
