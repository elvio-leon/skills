						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input {
							Expression = ":local function split(s) local a={} for p0 in string.gmatch(s..'|','([^|]*)|') do local p=string.gsub(p0,'^%s+','') p=string.gsub(p,'%s+$','') table.insert(a,p) end return a end\nlocal function num(s) s=string.gsub(s or '','%.','') s=string.gsub(s,',','.') s=string.gsub(s,'[^%d%.%-]','') return tonumber(s) or 0 end\nlocal function fmt(v,d) local s=string.format('%.'..(d or 0)..'f',v) local i,f=string.match(s,'^(%-?%d+)%.?(%d*)$') i=i or s local r=string.reverse(i) r=string.gsub(r,'(%d%d%d)','%1.') r=string.reverse(r) r=string.gsub(r,'^%.','') r=string.gsub(r,'^%-%.','-') if f and f~='' then r=r..','..f end return r end\nlocal function dec(s) local f=string.match(s or '',',(%d+)') return f and #f or 0 end\nlocal s=NumeroSrc.StyledText.Value or '0'\nlocal v=num(s)\nlocal k=min(max(((time-comp.RenderStart)-6*Ctrl.Speed)/max(Ctrl.CountDur*Ctrl.Speed,1),0),1)\nk=1-(1-k)^5\nreturn Text((Prefisso.StyledText.Value or '')..fmt(v*k,dec(s))..(Suffisso.StyledText.Value or ''))",
