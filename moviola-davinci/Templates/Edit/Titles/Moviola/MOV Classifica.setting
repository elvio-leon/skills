					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input {
							Expression = ":local src=(Righe.StyledText.Value or '')\nlocal L={} for l0 in string.gmatch(src..'\\n','([^\\n]*)\\n') do local l=string.gsub(l0,'^%s+','') l=string.gsub(l,'%s+$','') if l~='' then table.insert(L,l) end end\nlocal function split(s) local a={} for p0 in string.gmatch(s..'|','([^|]*)|') do local p=string.gsub(p0,'^%s+','') p=string.gsub(p,'%s+$','') table.insert(a,p) end return a end\nlocal function num(s) s=string.gsub(s or '','%.','') s=string.gsub(s,',','.') s=string.gsub(s,'[^%d%.%-]','') return tonumber(s) or 0 end\nlocal function fmt(v,d) local s=string.format('%.'..(d or 0)..'f',v) local i,f=string.match(s,'^(%-?%d+)%.?(%d*)$') i=i or s local r=string.reverse(i) r=string.gsub(r,'(%d%d%d)','%1.') r=string.reverse(r) r=string.gsub(r,'^%.','') r=string.gsub(r,'^%-%.','-') if f and f~='' then r=r..','..f end return r end\nlocal function dec(s) local f=string.match(s or '',',(%d+)') return f and #f or 0 end\nlocal a=split(L[8] or '') return Text(a[2] or '')",
