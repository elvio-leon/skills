							Expression = ":local function chars(s) local t={} for c in string.gmatch(s,'[%z\\1-\\127\\194-\\244][\\128-\\191]*') do table.insert(t,c) end return t end\nlocal s=Sorgente.StyledText.Value or ''\nlocal t=chars(s)\nlocal f=((time-comp.RenderStart)-Ctrl.Delay*Ctrl.Speed)\nlocal n=floor(f*Ctrl.Rate/25/Ctrl.Speed)\nif n<0 then n=0 end\nif n>#t then n=#t end\nlocal out=table.concat(t,'',1,n)\nlocal done = n>=#t\nlocal blink = (floor((time-comp.RenderStart)/7)%2==0)\nif Ctrl.Cursor>0.5 and (not done or blink) then out=out..'_' end\nreturn Text(out)",
						},
