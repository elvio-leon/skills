						StyledText = Input {
							Expression = ":local function parse(fld,team,G) local s=fld.StyledText.Value or '' for l0 in string.gmatch(s..'\\n','([^\\n]*)\\n') do local l=string.gsub(l0,'^%s+','') if l~='' then local m=tonumber(string.match(l,'(%d+)')) or 0 table.insert(G,{m=m,t=team,s=l}) end end end\nlocal G={} parse(MarcCasa,1,G) parse(MarcOspiti,2,G)\ntable.sort(G,function(a,b) return a.m<b.m end)\nlocal f=((time-comp.RenderStart))-Ctrl.First*Ctrl.Speed\nlocal shown=(f<0) and 0 or (floor(f/(Ctrl.Step*Ctrl.Speed))+1)\nif shown>#G then shown=#G end\nlocal a,b=0,0 for i=1,shown do if G[i].t==1 then a=a+1 else b=b+1 end end return Text(a..' – '..b)",
						},
						Font = Input { Value = "Anton", },
						Style = Input { Value = "Regular", },
						Size = Input {
							Expression = ":local function parse(fld,team,G) local s=fld.StyledText.Value or '' for l0 in string.gmatch(s..'\\n','([^\\n]*)\\n') do local l=string.gsub(l0,'^%s+','') if l~='' then local m=tonumber(string.match(l,'(%d+)')) or 0 table.insert(G,{m=m,t=team,s=l}) end end end\nlocal G={} parse(MarcCasa,1,G) parse(MarcOspiti,2,G)\ntable.sort(G,function(a,b) return a.m<b.m end)\nlocal f=((time-comp.RenderStart))-Ctrl.First*Ctrl.Speed\nlocal shown=(f<0) and 0 or (floor(f/(Ctrl.Step*Ctrl.Speed))+1)\nif shown>#G then shown=#G end\nif shown<1 then return 190/1920 end local d=f-(shown-1)*Ctrl.Step*Ctrl.Speed return 190/1920*(1+0.25*max(1-d/8,0))",
						},
