{
	Tools = ordered() {
		MOV_BruciaturaPellicola = MacroOperator {
			Inputs = ordered() {
				MainInput1 = InstanceInput {
					SourceOp = "Taglio",
					Source = "Background",
					Name = "Clip in uscita",
				},
				MainInput2 = InstanceInput {
					SourceOp = "Taglio",
					Source = "Foreground",
					Name = "Clip in entrata",
				},
				Input1 = InstanceInput {
					SourceOp = "Ctrl",
					Source = "Heat",
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Bagliore",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Taglio = Dissolve {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Mix = Input {
							Expression = "min(max((Ctrl.Mix-0.5+0.03)/0.06,0),1)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				Campo = FastNoise {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						Detail = Input { Value = 5, },
						XScale = Input { Value = 2.2, },
						Contrast = Input { Value = 1.3, },
						SeetheRate = Input { Value = 0.25, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Lato = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = { 1, 0.5 }, },
						Width = Input { Value = 1.35417, },
						Height = Input { Value = 2.22222, },
						SoftEdge = Input { Value = 0.45, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				Fiamma = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Campo",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "LatoSolido",
							Source = "Output",
						},
						ApplyMode = Input { Value = FuID { "Screen" }, },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input { Value = 0.55, },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
				},
				LatoSolido = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input {
							SourceOp = "Lato",
							Source = "Mask",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
				},
				Bianco = BitmapMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Image = Input {
							SourceOp = "Fiamma",
							Source = "Output",
						},
						Channel = Input { Value = FuID { "Luminance" }, },
						Low = Input {
							Expression = "(1.25-((Ctrl.Mix)<0.5 and (Ctrl.Mix*2)^2 or 1-((Ctrl.Mix-0.5)*2)^0.55)*1.55)+0.16",
						},
						High = Input {
							Expression = "(1.25-((Ctrl.Mix)<0.5 and (Ctrl.Mix*2)^2 or 1-((Ctrl.Mix-0.5)*2)^0.55)*1.55)+0.26",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 550, 0 } },
				},
				Arancio = BitmapMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Image = Input {
							SourceOp = "Fiamma",
							Source = "Output",
						},
						Channel = Input { Value = FuID { "Luminance" }, },
						Low = Input {
							Expression = "(1.25-((Ctrl.Mix)<0.5 and (Ctrl.Mix*2)^2 or 1-((Ctrl.Mix-0.5)*2)^0.55)*1.55)+0.03",
						},
						High = Input {
							Expression = "(1.25-((Ctrl.Mix)<0.5 and (Ctrl.Mix*2)^2 or 1-((Ctrl.Mix-0.5)*2)^0.55)*1.55)+0.13",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 660, 0 } },
				},
				Rosso = BitmapMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Image = Input {
							SourceOp = "Fiamma",
							Source = "Output",
						},
						Channel = Input { Value = FuID { "Luminance" }, },
						Low = Input {
							Expression = "(1.25-((Ctrl.Mix)<0.5 and (Ctrl.Mix*2)^2 or 1-((Ctrl.Mix-0.5)*2)^0.55)*1.55)-0.08",
						},
						High = Input {
							Expression = "(1.25-((Ctrl.Mix)<0.5 and (Ctrl.Mix*2)^2 or 1-((Ctrl.Mix-0.5)*2)^0.55)*1.55)+0.02",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 770, 0 } },
				},
				StratoRosso = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.75, },
						TopLeftGreen = Input { Value = 0.2, },
						TopLeftBlue = Input { Value = 0.04, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input {
							SourceOp = "Rosso",
							Source = "Mask",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 880, 0 } },
				},
				StratoArancio = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.6, },
						TopLeftBlue = Input { Value = 0.15, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input {
							SourceOp = "Arancio",
							Source = "Mask",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 990, 0 } },
				},
				StratoBianco = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.97, },
						TopLeftBlue = Input { Value = 0.88, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input {
							SourceOp = "Bianco",
							Source = "Mask",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 1100, 0 } },
				},
				M1 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Taglio",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "StratoRosso",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Expression = "Ctrl.Heat*0.9",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 1210, 0 } },
				},
				M2 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "M1",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "StratoArancio",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Expression = "min(Ctrl.Heat,1)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 1320, 0 } },
				},
				M3 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "M2",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "StratoBianco",
							Source = "Output",
						},
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 1430, 0 } },
				},
				Bagliore = Blur {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input {
							SourceOp = "M3",
							Source = "Output",
						},
						XBlurSize = Input { Value = 4, },
					},
					ViewInfo = OperatorInfo { Pos = { 1540, 0 } },
				},
				Ctrl = Dissolve {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Mix = Input {
							SourceOp = "CtrlCurve",
							Source = "Value",
						},
						Heat = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 1650, 0 } },
					UserControls = ordered() {
						Heat = {
							LINKS_Name = "Intensità",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0.3,
							INP_MaxScale = 1.5,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				CtrlCurve = LUTLookup {
					Inputs = {
						Source = Input { Value = FuID { "Duration" }, },
						Lookup = Input {
							SourceOp = "CtrlCurveLookup",
							Source = "Value",
						},
					},
				},
				CtrlCurveLookup = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							[1] = { 1, LH = { 0.666666666666667, 0.666666666666667 }, Flags = { Linear = true } }
						}
					},
					SplineColor = { Red = 255, Green = 255, Blue = 255 },
				},
			},
		},
	},
	ActiveTool = "MOV_BruciaturaPellicola"
}
