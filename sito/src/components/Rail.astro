---
/** Header di sezione: label Mono a sinistra, numerazione a destra. */
interface Props {
  label: string;
  index?: number;
  total?: number;
}
const { label, index, total } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="rail t-label">
  <span>{label}</span>
  {
    index && total && (
      <span class="rail__count" aria-hidden="true">
        {pad(index)} / {pad(total)}
      </span>
    )
  }
</div>

<style>
  .rail {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-2);
    padding-top: var(--s-2);
    border-top: var(--hairline) solid var(--border);
    color: var(--text-secondary);
    margin-bottom: var(--s-5);
  }
</style>
