---
import { GOATCOUNTER_CODE } from '../config';

/**
 * Punto unico per gli analytics. Oggi: nessuno.
 * Per GoatCounter (gratuito, senza cookie) basta impostare GOATCOUNTER_CODE in src/config.ts
 * e aggiungere https://gc.zgo.at e https://<codice>.goatcounter.com alla CSP in netlify.toml.
 */
---

{
  GOATCOUNTER_CODE && (
    <script
      is:inline
      data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
      async
      src="https://gc.zgo.at/count.js"
    />
  )
}
