				TH_Dis = Dissolve {
					Inputs = {
						Background = Input {
							SourceOp = "TH_OBG",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "TH_FBG",
							Source = "Output",
						},
						Mix = Input {
							Value = 0,
							Expression = ":local fps, t0 = 30, 0 pcall(function() local r = comp:GetPrefs(\"Comp.FrameFormat.Rate\") if r and r > 0 then fps = r end t0 = comp.RenderStart or 0 end) local T = (time - t0) / fps local function cl(x) if x < 0 then return 0 elseif x > 1 then return 1 end return x end local function pr(a, b) return cl((T - a) / (b - a)) end local function lerp(a, b, u) return a + (b - a) * u end local function oback(u) local s = 1.70158 u = u - 1 return 1 + (s + 1) * u * u * u + s * u * u end local function ocub(u) return 1 - (1 - u) ^ 3 end local function icub(u) return u * u * u end local function iocub(u) if u < 0.5 then return 4 * u * u * u end return 1 - (-2 * u + 2) ^ 3 / 2 end local function bump(u) return math.sin(math.pi * cl(u)) end local function press(tc) local u = pr(tc, tc + 0.16) if u > 0 and u < 1 then return 1 - 0.07 * bump(u) end return 1 end local function appear(a, b) local u = pr(a, b) local s = 0.55 if u > 0 then s = lerp(0.55, 1, oback(u)) end return s, ocub(pr(a, a + (b - a) * 0.55)) end local function outro() local u = pr(4.3, 4.85) return lerp(1, 0.65, icub(u)), 1 - u * u end return ocub(pr(1.56, 1.6600000000000001))",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 550, 33 } },
