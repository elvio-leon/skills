				BL_Xf = Transform {
					Inputs = {
						Input = Input {
							SourceOp = "BL_BG",
							Source = "Output",
						},
						Pivot = Input {
							Value = { 0.5, 0.518518519 },
						},
						Center = Input {
							Value = { 0.460110474, 0.5 },
							Expression = ":local fps, t0 = 30, 0 pcall(function() local r = comp:GetPrefs(\"Comp.FrameFormat.Rate\") if r and r > 0 then fps = r end t0 = comp.RenderStart or 0 end) local T = (time - t0) / fps local function cl(x) if x < 0 then return 0 elseif x > 1 then return 1 end return x end local function pr(a, b) return cl((T - a) / (b - a)) end local function lerp(a, b, u) return a + (b - a) * u end local function oback(u) local s = 1.70158 u = u - 1 return 1 + (s + 1) * u * u * u + s * u * u end local function ocub(u) return 1 - (1 - u) ^ 3 end local function icub(u) return u * u * u end local function iocub(u) if u < 0.5 then return 4 * u * u * u end return 1 - (-2 * u + 2) ^ 3 / 2 end local function bump(u) return math.sin(math.pi * cl(u)) end local function press(tc) local u = pr(tc, tc + 0.16) if u > 0 and u < 1 then return 1 - 0.07 * bump(u) end return 1 end local function appear(a, b) local u = pr(a, b) local s = 0.55 if u > 0 then s = lerp(0.55, 1, oback(u)) end return s, ocub(pr(a, a + (b - a) * 0.55)) end local function outro() local u = pr(4.3, 4.85) return lerp(1, 0.65, icub(u)), 1 - u * u end local function tw(tl, fb) local ok, w = pcall(function() local o = tl.Output[0] local d = o.DataWindow return (d[3] - d[1]) * 1920 / o.Width end) if ok and type(w) == \"number\" and w > 1 and w < 1900 then return w end return fb end local TL, TS, TD = tw(LK_Txt, 167.170), tw(SB_Txt1, 146.545), tw(SB_Txt2, 139.176) local LW = math.max(330, 146.0 + TL) local SW = math.max(420, 88.0 + TS, 150.0 + TD) local left = 960 - (LW + 32 + SW) / 2 local LCX = left + LW / 2 local SCX = left + LW + 32 + SW / 2 local ICX = -(58.0 + TL) / 2 + 22.0 local BCX = -(62.0 + TD) / 2 + 24.0 return Point(0.5 + BCX / 1920, 0.5)",
						},
						Angle = Input {
							Value = 0,
							Expression = ":local fps, t0 = 30, 0 pcall(function() local r = comp:GetPrefs(\"Comp.FrameFormat.Rate\") if r and r > 0 then fps = r end t0 = comp.RenderStart or 0 end) local T = (time - t0) / fps local function cl(x) if x < 0 then return 0 elseif x > 1 then return 1 end return x end local function pr(a, b) return cl((T - a) / (b - a)) end local function lerp(a, b, u) return a + (b - a) * u end local function oback(u) local s = 1.70158 u = u - 1 return 1 + (s + 1) * u * u * u + s * u * u end local function ocub(u) return 1 - (1 - u) ^ 3 end local function icub(u) return u * u * u end local function iocub(u) if u < 0.5 then return 4 * u * u * u end return 1 - (-2 * u + 2) ^ 3 / 2 end local function bump(u) return math.sin(math.pi * cl(u)) end local function press(tc) local u = pr(tc, tc + 0.16) if u > 0 and u < 1 then return 1 - 0.07 * bump(u) end return 1 end local function appear(a, b) local u = pr(a, b) local s = 0.55 if u > 0 then s = lerp(0.55, 1, oback(u)) end return s, ocub(pr(a, a + (b - a) * 0.55)) end local function outro() local u = pr(4.3, 4.85) return lerp(1, 0.65, icub(u)), 1 - u * u end local function bell() local u = pr(2.9, 3.9) if u <= 0 or u >= 1 then return 0 end local c = 3.5 local up = 1 / (4 * c) return 26 / ((1 - up) ^ 2) * (1 - u) ^ 2 * math.sin(2 * math.pi * c * u) end return -bell()",
						},
